        walletPhone: '01012345678',
        amount: 100,
        currency: 'ج.م',
        method: 'فودافون كاش',
        status: 'success',
        timestamp: new Date().toISOString(),
        isSample: true
      },
      {
        id: 'PAY-318491',
        bookingId: 'BK-719342',
        patientName: 'سارة عادل عبد الرحمن',
        walletPhone: '01198765432',
        amount: 100,
        currency: 'ج.م',
        method: 'فودافون كاش',
        status: 'success',
        timestamp: new Date().toISOString(),
        isSample: true
      }
    ];

    Storage.set(STORAGE_KEYS.SETTINGS, defaultSettings);
    Storage.set(STORAGE_KEYS.AUTH, defaultAuth);
    Storage.set(STORAGE_KEYS.SCHEDULE, defaultSchedule);
    Storage.set(STORAGE_KEYS.OVERRIDES, defaultOverrides);
    Storage.set(STORAGE_KEYS.BOOKINGS, defaultBookings);
    Storage.set(STORAGE_KEYS.PAYMENTS, defaultPayments);
  }

  /* ==========================================================================
     5. TOAST NOTIFICATIONS
     ========================================================================== */

  function showToast(title, message, type = 'success', duration = 3500) {
    const region = document.getElementById('toast-region');
    if (!region) return;

    const toast = document.createElement('div');
    toast.className = `toast toast--${type}`;
    toast.setAttribute('role', 'alert');

    let iconHtml = Icons.check;
    if (type === 'error') iconHtml = Icons.x;
    if (type === 'warning') iconHtml = Icons.alert;
    if (type === 'info') iconHtml = Icons.info;

    toast.innerHTML = `
      <div class="toast__icon">${iconHtml}</div>
      <div class="toast__copy">
        <strong>${title}</strong>
        <span>${message}</span>
      </div>
      <button class="toast__close" aria-label="إغلاق التنبيه">${Icons.x}</button>
    `;

    const closeBtn = toast.querySelector('.toast__close');
    const dismiss = () => {
      toast.classList.add('is-leaving');
      toast.addEventListener('animationend', () => toast.remove(), { once: true });
    };

    closeBtn.addEventListener('click', dismiss);
    region.appendChild(toast);

    if (duration > 0) {
      setTimeout(dismiss, duration);
    }
  }

  /* ==========================================================================
     6. MODAL SYSTEM
     ========================================================================== */

  const Modal = {
    root: null,

    init() {
      this.root = document.getElementById('modal-root');
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') this.close();
      });
    },

    open(htmlContent, customClass = '') {
      if (!this.root) return;
      document.body.classList.add('modal-open');
      this.root.innerHTML = `
        <div class="modal-backdrop" id="modal-backdrop">
          <div class="modal ${customClass}" role="dialog" aria-modal="true">
            ${htmlContent}
          </div>
        </div>
      `;

      const backdrop = document.getElementById('modal-backdrop');
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) this.close();
      });

      const closeBtns = this.root.querySelectorAll('[data-modal-close]');
      closeBtns.forEach(btn => btn.addEventListener('click', () => this.close()));
    },

    close() {
      if (!this.root) return;
      document.body.classList.remove('modal-open');
      this.root.innerHTML = '';
    }
  };

  /* ==========================================================================
     7. CLINIC ENGINE (DATA LAYER)
     ========================================================================== */

  const ClinicEngine = {
    getSettings() {
      return Storage.get(STORAGE_KEYS.SETTINGS, {});
    },

    updateSettings(newSettings) {
      const current = this.getSettings();
      const updated = { ...current, ...newSettings };
      Storage.set(STORAGE_KEYS.SETTINGS, updated);
      return updated;
    },

    getAuth() {
      return Storage.get(STORAGE_KEYS.AUTH, { username: 'doctor', password: 'Doctor@123' });
    },

    updateCredentials(currentPassword, newUsername, newPassword) {
      const auth = this.getAuth();
      if (currentPassword !== auth.password) {
        return { success: false, error: 'كلمة المرور الحالية غير صحيحة.' };
      }
      if (!newUsername || newUsername.trim().length < 3) {
        return { success: false, error: 'اسم المستخدم الجديد يجب أن يتكون من 3 أحرف على الأقل.' };
      }
      if (!newPassword || newPassword.length < 6) {
        return { success: false, error: 'كلمة المرور الجديدة يجب أن تتكون من 6 خانات على الأقل.' };
      }

      auth.username = newUsername.trim();
      auth.password = newPassword;
      Storage.set(STORAGE_KEYS.AUTH, auth);
      return { success: true };
    },

    getWeeklySchedule() {
      return Storage.get(STORAGE_KEYS.SCHEDULE, {});
    },

    getOverrides() {
      return Storage.get(STORAGE_KEYS.OVERRIDES, {});
    },

    getBookings() {
      return Storage.get(STORAGE_KEYS.BOOKINGS, []);
    },

    getPayments() {
      return Storage.get(STORAGE_KEYS.PAYMENTS, []);
    },

    // Get combined schedule for a specific date (combines recurring + single-date overrides + booking status)
    getScheduleForDate(dateIso) {
      const date = DateHelper.fromISODate(dateIso);
      const dayKey = DateHelper.getDayKey(date);
      const weekly = this.getWeeklySchedule();
      const overrides = this.getOverrides();
      const bookings = this.getBookings();

      let baseSlots = (weekly[dayKey] || []).map(s => ({ ...s, isRecurring: true }));

      // Apply single-date overrides if any
      const dayOverrides = overrides[dateIso] || [];
      for (const ov of dayOverrides) {
        if (ov.action === 'delete') {
          baseSlots = baseSlots.filter(s => s.id !== ov.slotId);
        } else if (ov.action === 'edit') {
          const idx = baseSlots.findIndex(s => s.id === ov.slotId);
          if (idx !== -1) {
            baseSlots[idx] = { ...baseSlots[idx], startTime: ov.startTime, endTime: ov.endTime, isOverride: true };
          }
        } else if (ov.action === 'add') {
          baseSlots.push({ id: ov.id, startTime: ov.startTime, endTime: ov.endTime, isOverride: true });
        }
      }

      // Sort by start time
      baseSlots.sort((a, b) => DateHelper.timeToMinutes(a.startTime) - DateHelper.timeToMinutes(b.startTime));

      // Attach booking info & availability state
      const processedSlots = baseSlots.map(slot => {
        // Find if slot is booked on this date
        const booking = bookings.find(b =>
          b.date === dateIso &&
          (b.slotId === slot.id || (b.startTime === slot.startTime && b.endTime === slot.endTime)) &&
          b.bookingStatus !== 'cancelled'
        );

        const isPast = DateHelper.isPastSlot(dateIso, slot.startTime);
        let status = 'available';

        if (booking) {
          status = 'booked';
        } else if (isPast) {
          status = 'past';
        }

        return {
          ...slot,
          date: dateIso,
          dayKey,
          status,
          booking: booking || null,
          formattedTime: `${DateHelper.formatTimeArabic(slot.startTime)} - ${DateHelper.formatTimeArabic(slot.endTime)}`,
          formattedStart: DateHelper.formatTimeArabic(slot.startTime),
          formattedEnd: DateHelper.formatTimeArabic(slot.endTime)
        };
      });

      return processedSlots;
    },

    // Add session slot
    addSlot({ dayKey, dateIso, startTime, endTime, scope = 'weekly' }) {
      // Validation
      if (DateHelper.timeToMinutes(endTime) <= DateHelper.timeToMinutes(startTime)) {
        return { success: false, error: 'وقت نهاية الجلسة يجب أن يكون بعد وقت البداية.' };
      }

      const existingSlots = this.getScheduleForDate(dateIso);
      if (DateHelper.hasOverlap(existingSlots, startTime, endTime)) {
        return { success: false, error: 'يوجد تعارض في التوقيت! الجلسة تتداخل مع جلسة أخرى مسجلة.' };
      }

      const newId = `slot-${Date.now()}-${Math.floor(Math.random() * 1000)}`;

      if (scope === 'weekly') {
        const weekly = this.getWeeklySchedule();
        if (!weekly[dayKey]) weekly[dayKey] = [];
        weekly[dayKey].push({ id: newId, startTime, endTime });
        weekly[dayKey].sort((a, b) => DateHelper.timeToMinutes(a.startTime) - DateHelper.timeToMinutes(b.startTime));
        Storage.set(STORAGE_KEYS.SCHEDULE, weekly);
      } else {
        // Single date override
        const overrides = this.getOverrides();
        if (!overrides[dateIso]) overrides[dateIso] = [];
        overrides[dateIso].push({ action: 'add', id: newId, startTime, endTime });
        Storage.set(STORAGE_KEYS.OVERRIDES, overrides);
      }

      return { success: true };
    },

    // Edit session slot
    editSlot({ slotId, dayKey, dateIso, startTime, endTime, scope = 'weekly' }) {
      if (DateHelper.timeToMinutes(endTime) <= DateHelper.timeToMinutes(startTime)) {
        return { success: false, error: 'وقت نهاية الجلسة يجب أن يكون بعد وقت البداية.' };
      }

      const existingSlots = this.getScheduleForDate(dateIso);
      if (DateHelper.hasOverlap(existingSlots, startTime, endTime, slotId)) {
        return { success: false, error: 'يوجد تعارض في التوقيت! الموعد الجديد يتداخل مع جلسة أخرى.' };
      }

      if (scope === 'weekly') {
        const weekly = this.getWeeklySchedule();
        const slots = weekly[dayKey] || [];
        const target = slots.find(s => s.id === slotId);
        if (target) {
          target.startTime = startTime;
          target.endTime = endTime;
          slots.sort((a, b) => DateHelper.timeToMinutes(a.startTime) - DateHelper.timeToMinutes(b.startTime));
          Storage.set(STORAGE_KEYS.SCHEDULE, weekly);
        }
      } else {
        // Single date override
        const overrides = this.getOverrides();
        if (!overrides[dateIso]) overrides[dateIso] = [];
        overrides[dateIso].push({ action: 'edit', slotId, startTime, endTime });
        Storage.set(STORAGE_KEYS.OVERRIDES, overrides);
      }

      return { success: true };
    },

    // Delete session slot
    deleteSlot({ slotId, dayKey, dateIso, scope = 'weekly' }) {
      if (scope === 'weekly') {
        const weekly = this.getWeeklySchedule();
        if (weekly[dayKey]) {
          weekly[dayKey] = weekly[dayKey].filter(s => s.id !== slotId);
          Storage.set(STORAGE_KEYS.SCHEDULE, weekly);
        }
      } else {
        // Single date override
        const overrides = this.getOverrides();
        if (!overrides[dateIso]) overrides[dateIso] = [];
        overrides[dateIso].push({ action: 'delete', slotId });
        Storage.set(STORAGE_KEYS.OVERRIDES, overrides);
      }

      return { success: true };
    },

    // Create a new booking
    createBooking({ patientName, patientPhone, dateIso, slot, amount, walletPhone }) {
      // Race condition / duplicate booking check
      const currentSlots = this.getScheduleForDate(dateIso);
      const targetSlot = currentSlots.find(s => s.id === slot.id || (s.startTime === slot.startTime && s.endTime === slot.endTime));

      if (!targetSlot || targetSlot.status !== 'available') {
        return {
          success: false,
          error: 'عذراً! تم حجز هذه الجلسة بالفعل أو لم تعد متاحة. يرجى اختيار موعد آخر.'
        };
      }

      const bookingId = 'BK-' + Math.floor(100000 + Math.random() * 900000);
      const paymentId = 'PAY-' + Math.floor(100000 + Math.random() * 900000);
      const nowIso = new Date().toISOString();

      const newBooking = {
        id: bookingId,
        patientName: patientName.trim(),
        patientPhone: patientPhone.trim(),
        date: dateIso,
        startTime: slot.startTime,
        endTime: slot.endTime,
        slotId: slot.id,
        amount: Number(amount),
        currency: 'ج.م',
        paymentId,
        paymentMethod: 'فودافون كاش',
        walletPhone: walletPhone.trim(),
        paymentStatus: 'paid',
        bookingStatus: 'confirmed',
        createdAt: nowIso
      };

      const newPayment = {
        id: paymentId,
        bookingId,
        patientName: patientName.trim(),
        walletPhone: walletPhone.trim(),
        amount: Number(amount),
        currency: 'ج.م',
        method: 'فودافون كاش',
        status: 'success',
        timestamp: nowIso
      };

      const bookings = this.getBookings();
      bookings.unshift(newBooking);
      Storage.set(STORAGE_KEYS.BOOKINGS, bookings);

      const payments = this.getPayments();
      payments.unshift(newPayment);
      Storage.set(STORAGE_KEYS.PAYMENTS, payments);

      return {
        success: true,
        booking: newBooking,
        payment: newPayment
      };
    },

    // Update booking status
    updateBookingStatus(bookingId, newStatus) {
      const bookings = this.getBookings();
      const b = bookings.find(item => item.id === bookingId);
      if (b) {
        b.bookingStatus = newStatus;
        Storage.set(STORAGE_KEYS.BOOKINGS, bookings);
        return true;
      }
      return false;
    },

    // Calculate live dashboard statistics
    getDashboardStats() {
      const todayISO = DateHelper.todayISO();
      const todaySlots = this.getScheduleForDate(todayISO);
      const allBookings = this.getBookings();
      const allPayments = this.getPayments();

      const todayBookings = allBookings.filter(b => b.date === todayISO && b.bookingStatus !== 'cancelled');
      const todayAvailable = todaySlots.filter(s => s.status === 'available').length;
      const todayBooked = todaySlots.filter(s => s.status === 'booked').length;

      // Upcoming bookings (strictly from today onwards)
      const upcomingBookings = allBookings.filter(b => b.date >= todayISO && b.bookingStatus === 'confirmed');

      // Total payments recorded
      const totalRevenue = allPayments
        .filter(p => p.status === 'success')
        .reduce((sum, p) => sum + (Number(p.amount) || 0), 0);

      // Find immediate next appointment today
      const nowMinutes = new Date().getHours() * 60 + new Date().getMinutes();
      const upcomingToday = todayBookings
        .filter(b => DateHelper.timeToMinutes(b.startTime) >= nowMinutes)
        .sort((a, b) => DateHelper.timeToMinutes(a.startTime) - DateHelper.timeToMinutes(b.startTime));

      const nextAppointment = upcomingToday[0] || todayBookings[0] || null;

      return {
        todayBookingsCount: todayBookings.length,
        todayAvailableCount: todayAvailable,
        todayBookedCount: todayBooked,
        upcomingCount: upcomingBookings.length,
        totalRevenue,
        todayBookingsList: todayBookings,
        nextAppointment
      };
    }
  };

  /* ==========================================================================
     8. AUTHENTICATION (DOCTOR PORTAL)
     ========================================================================== */

  const Auth = {
    isLoggedIn() {
      const session = Storage.get(STORAGE_KEYS.SESSION, null);
      if (!session) return false;
      // Optional session validity check
      return !!session.token;
    },

    login(username, password, remember = true) {
      const creds = ClinicEngine.getAuth();
      if (username.trim() === creds.username && password === creds.password) {
        const session = {
          username: creds.username,
          token: 'token-' + Date.now(),
          loginTime: new Date().toISOString()
        };
        Storage.set(STORAGE_KEYS.SESSION, session);
        return { success: true };
      }
      return { success: false, error: 'اسم المستخدم أو كلمة المرور غير صحيحة.' };
    },

    logout() {
      Storage.remove(STORAGE_KEYS.SESSION);
    }
  };

  /* ==========================================================================
     9. APPLICATION ROUTER & STATE
     ========================================================================== */

  const App = {
    currentRoute: 'landing',
    activeSubView: 'overview', // 'overview', 'schedule', 'today', 'all-bookings', 'settings'
    patientBookingState: {
      selectedDate: null,
      selectedSlot: null,
      patientName: '',
      patientPhone: '',
      paymentScenario: 'success', // 'success' or 'fail'
      bookingResult: null
    },

    init() {
      initDemoData();
      Modal.init();

      // Setup window hash listener
      window.addEventListener('hashchange', () => this.handleRouting());

      // Real-time synchronization across browser tabs
      window.addEventListener('storage', (e) => {
        if (Object.values(STORAGE_KEYS).includes(e.key)) {
          this.refreshCurrentView();
          if (e.key === STORAGE_KEYS.BOOKINGS && this.currentRoute === 'doctor') {
            showToast('تحديث جديد', 'تم تسجيل حجز جديد في النظام.', 'info');
          }
        }
      });

      // Initial route
      if (!window.location.hash) {
        window.location.hash = '#landing';
      } else {
        this.handleRouting();
      }
    },

    handleRouting() {
      const hash = window.location.hash.replace(/^#/, '');
      const parts = hash.split('/');
      const mainRoute = parts[0] || 'landing';
      const subRoute = parts[1] || 'overview';

      // Doctor protection guard
      if (mainRoute === 'doctor' && !Auth.isLoggedIn()) {
        showToast('تسجيل الدخول مطلوب', 'يرجى تسجيل الدخول للوصول إلى لوحة تحكم العيادة.', 'warning');
        this.navigate('doctor-login');
        return;
      }

      this.currentRoute = mainRoute;
      this.activeSubView = subRoute;

      this.render();
    },

    navigate(route, subView = '') {
      const newHash = subView ? `#${route}/${subView}` : `#${route}`;
      if (window.location.hash !== newHash) {
        window.location.hash = newHash;
      }
      this.handleRouting();
    },

    refreshCurrentView() {
      this.render();
    },

    render() {
      const appContainer = document.getElementById('app');
      if (!appContainer) return;

      switch (this.currentRoute) {
        case 'landing':
          appContainer.innerHTML = Views.Landing();
          Views.bindLandingEvents();
          break;
        case 'doctor-login':
          if (Auth.isLoggedIn()) {
            this.navigate('doctor', 'overview');
            return;
          }
          appContainer.innerHTML = Views.DoctorLogin();
          Views.bindDoctorLoginEvents();
          break;
        case 'doctor':
          appContainer.innerHTML = Views.DoctorShell(this.activeSubView);
          Views.bindDoctorShellEvents(this.activeSubView);
          break;
        case 'patient':
          appContainer.innerHTML = Views.PatientPortal();
          Views.bindPatientPortalEvents();
          break;
        default:
          this.navigate('landing');
      }

      // Render floating demo helper pill
      this.renderFloatingHelper();
    },

    renderFloatingHelper() {
      let existing = document.getElementById('demo-quick-switcher');
      if (existing) existing.remove();

      const switcher = document.createElement('div');
      switcher.id = 'demo-quick-switcher';
      switcher.style.cssText = `
        position: fixed;
        bottom: 18px;
        left: 18px;
        z-index: 99;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px;
        background: rgba(6, 24, 38, 0.94);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 99px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(10px);
        font-family: inherit;
        font-size: 11px;
      `;

      switcher.innerHTML = `
        <button id="sw-landing" class="btn btn--sm" style="padding: 4px 9px; min-height: 28px; border-radius: 99px; color: #fff; background: transparent; border: 0;" title="الرئيسية">
          ${Icons.home} <span style="margin-right: 4px;">الرئيسية</span>
        </button>
        <button id="sw-patient" class="btn btn--sm" style="padding: 4px 9px; min-height: 28px; border-radius: 99px; color: #7ce2c9; background: rgba(19, 181, 139, 0.15); border: 0;" title="بوابة حجز المرضى">
          ${Icons.calendar} <span style="margin-right: 4px;">حجز المرضى</span>
        </button>
        <button id="sw-doctor" class="btn btn--sm" style="padding: 4px 9px; min-height: 28px; border-radius: 99px; color: #fff; background: transparent; border: 0;" title="لوحة الطبيب">
          ${Icons.stethoscope} <span style="margin-right: 4px;">لوحة الطبيب</span>
        </button>
        <button id="sw-reset" class="btn btn--sm" style="padding: 4px 7px; min-height: 28px; border-radius: 99px; color: #f59e0b; background: transparent; border: 0;" title="إعادة ضبط البيانات التجريبية">
          ${Icons.refresh}
        </button>
      `;

      document.body.appendChild(switcher);

      switcher.querySelector('#sw-landing').onclick = () => App.navigate('landing');
      switcher.querySelector('#sw-patient').onclick = () => App.navigate('patient');
      switcher.querySelector('#sw-doctor').onclick = () => {
        if (Auth.isLoggedIn()) App.navigate('doctor', 'overview');
        else App.navigate('doctor-login');
      };
      switcher.querySelector('#sw-reset').onclick = () => Modals.openResetDataConfirm();
    }
  };

  /* ==========================================================================
     10. HTML VIEWS & COMPONENTS
     ========================================================================== */

  const Views = {
    /* ---------------- LANDING PAGE ---------------- */
    Landing() {
      const settings = ClinicEngine.getSettings();
      const stats = ClinicEngine.getDashboardStats();
      const todayArabic = DateHelper.formatDateArabic(DateHelper.todayISO());

      return `
        <div class="landing">
          <!-- Particle canvas — covers entire landing, mouse-interactive -->
          <canvas id="landing-particles"></canvas>

          <!-- Heart canvas — floating heart above hero -->
          <canvas id="landing-heart"></canvas>

          <!-- Cinematic vignette overlay -->
          <div class="cinema-vignette"></div>

          <!-- Ambient orbs -->
          <div class="landing-orb landing-orb--1"></div>
          <div class="landing-orb landing-orb--2"></div>
          <div class="landing-orb landing-orb--3"></div>
          <div class="landing-orb landing-orb--4"></div>

          <!-- Horizontal scan line -->
          <div class="cinema-scanline"></div>

          <header class="landing-header-wrap" id="gsap-header">
            <div class="landing-header">
              <div class="brand brand--inverse" id="gsap-brand">
                <div class="brand-mark">
                  <svg viewBox="0 0 64 64" fill="none"><path d="M12 34h11l6-17 9 31 6-22 4 8h9" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="brand-word">
                  <strong>${settings.doctorName || 'د. أحمد محمد'}</strong>
                  <span>${settings.clinicName || 'عيادة الشفاء التخصصية'}</span>
                </div>
              </div>
              <div class="landing-header-actions" id="gsap-header-actions">
                <button class="btn btn--ghost" id="landing-to-patient">${Icons.calendar} حجز موعد كشف</button>
                <button class="btn btn--outline" id="landing-to-doctor">${Icons.stethoscope} دخول الطبيب</button>
              </div>
            </div>
          </header>

          <!-- ═══ CINEMATIC SPLIT HERO ═══ -->
          <section class="cinema-hero">

            <!-- LEFT PANEL — Doctor Identity -->
            <div class="cinema-left" id="gsap-cinema-left">
              <!-- Glowing ring behind avatar -->
              <div class="doc-avatar-wrap" id="gsap-avatar-wrap">
                <div class="doc-avatar-ring doc-avatar-ring--outer"></div>
                <div class="doc-avatar-ring doc-avatar-ring--inner"></div>
                <div class="doc-avatar" id="gsap-avatar">
                  <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="50" cy="36" r="18" fill="rgba(67,201,165,0.18)" stroke="rgba(67,201,165,0.6)" stroke-width="1.5"/>
                    <path d="M50 54 C30 54 18 65 18 78 L82 78 C82 65 70 54 50 54Z" fill="rgba(67,201,165,0.18)" stroke="rgba(67,201,165,0.6)" stroke-width="1.5"/>
                    <path d="M37 36 C37 28.3 43 22 50 22 C57 22 63 28.3 63 36" stroke="rgba(67,201,165,0.9)" stroke-width="2" stroke-linecap="round"/>
                    <line x1="44" y1="44" x2="44" y2="52" stroke="rgba(67,201,165,0.7)" stroke-width="1.5"/>
                    <line x1="56" y1="44" x2="56" y2="52" stroke="rgba(67,201,165,0.7)" stroke-width="1.5"/>
                    <rect x="43" y="26" width="6" height="2" rx="1" fill="rgba(67,201,165,0.8)"/>
                    <rect x="46" y="23" width="2" height="8" rx="1" fill="rgba(67,201,165,0.8)"/>
                  </svg>
                </div>
                <!-- Live pulse dot -->
                <div class="doc-live-dot"><span></span>متاح للحجز</div>
              </div>

              <!-- Doctor name & title -->
              <div class="doc-identity" id="gsap-doc-identity">
                <div class="cinema-eyebrow">
                  <span class="cinema-eyebrow__line"></span>
                  <span>${settings.clinicName || 'عيادة الشفاء التخصصية'}</span>
                </div>
                <h1 class="cinema-title">
                  <span class="cinema-title__line" id="ct-line1">${settings.doctorName || 'د. أحمد محمد'}</span>
                  <em class="cinema-title__sub" id="ct-line2">${settings.specialty || 'استشاري طب الباطنة والجهاز الهضمي'}</em>
                </h1>

                <!-- Stats row -->
                <div class="cinema-stats" id="gsap-stats">
                  <div class="cinema-stat">
                    <span class="cinema-stat__num" data-target="${stats.todayBookedCount}">0</span>
                    <span class="cinema-stat__label">كشف اليوم</span>
                  </div>
                  <div class="cinema-stat-div"></div>
                  <div class="cinema-stat">
                    <span class="cinema-stat__num" data-target="${stats.todayAvailableCount}">0</span>
                    <span class="cinema-stat__label">موعد متاح</span>
                  </div>
                  <div class="cinema-stat-div"></div>
                  <div class="cinema-stat">
                    <span class="cinema-stat__num" data-target="${settings.price || 100}">0</span>
                    <span class="cinema-stat__label">ج.م سعر الكشف</span>
                  </div>
                </div>

                <!-- Lead -->
                <p class="cinema-lead" id="gsap-lead">
                  رعاية طبية متكاملة وتشخيص دقيق، مع نظام حجز إلكتروني منظم وتأكيد فوري. نضمن لك موعداً بدون انتظار.
                </p>

                <!-- CTAs -->
                <div class="cinema-actions" id="gsap-actions">
                  <button class="btn-cinema btn-cinema--primary" id="hero-patient-btn">
                    <span class="btn-cinema__glow"></span>
                    <span class="btn-cinema__icon">${Icons.calendar}</span>
                    <span>احجز موعدك الآن</span>
                  </button>
                  <button class="btn-cinema btn-cinema--ghost" id="hero-doctor-btn">
                    <span class="btn-cinema__icon">${Icons.lock}</span>
                    <span>دخول الطبيب</span>
                  </button>
                </div>

                <!-- Trust strip -->
                <div class="cinema-trust" id="gsap-trust">
                  <div class="cinema-trust__item">
                    <span class="cinema-trust__icon">${Icons.check}</span>
                    <span>حجز بدون حساب</span>
                  </div>
                  <div class="cinema-trust__item">
                    <span class="cinema-trust__icon">${Icons.shield}</span>
                    <span>دفع آمن فودافون كاش</span>
                  </div>
                  <div class="cinema-trust__item">
                    <span class="cinema-trust__icon">${Icons.calendar}</span>
                    <span>تأكيد فوري</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT PANEL — Visual / Cards -->
            <div class="cinema-right" id="gsap-cinema-right">
              <!-- Orbiting rings -->
              <div class="hero-ring hero-ring--1" id="gsap-ring1"><div class="hero-ring-dot" id="gsap-dot1"></div></div>
              <div class="hero-ring hero-ring--2" id="gsap-ring2"></div>
              <div class="hero-ring hero-ring--3" id="gsap-ring3"></div>

              <!-- Glow -->
              <div class="preview-glow" id="gsap-prev-glow"></div>

              <!-- Floating doctor badge -->
              <div class="float-card float-card--doctor" id="gsap-float-doc">
                <div class="mini-avatar">د</div>
                <div>
                  <strong>${settings.doctorName || 'د. أحمد محمد'}</strong>
                  <span>${settings.specialty || 'استشاري طب الباطنة'}</span>
                </div>
              </div>

              <!-- Floating availability badge -->
              <div class="float-card float-card--available" id="gsap-float-avail">
                <div class="available-head">
                  <span>مواعيد كشف اليوم</span>
                  <span class="icon">${Icons.calendar}</span>
                </div>
                <strong>${stats.todayAvailableCount} مواعيد متاحة</strong>
                <div class="available-foot">
                  <span>${Icons.check} حجز فوري مؤكد</span>
                </div>
              </div>

              <!-- Floating ECG badge -->
              <div class="float-card float-card--ecg" id="gsap-float-ecg">
                <div class="ecg-line">
                  <svg viewBox="0 0 120 40" fill="none">
                    <polyline points="0,20 20,20 28,5 36,35 44,20 54,20 62,12 68,28 74,20 120,20"
                      stroke="rgba(67,201,165,0.9)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <span>نبضة قلبك بأمان</span>
              </div>

              <!-- Clinic status preview card -->
              <div class="dashboard-preview" id="gsap-preview">
                <div class="preview-scan" id="gsap-scan"></div>
                <div class="dashboard-preview__top">
                  <div class="preview-brand">
                    <span class="brand-mark">${Icons.stethoscope}</span>
                    <span>${settings.clinicName || 'عيادة الشفاء التخصصية'}</span>
                  </div>
                  <div class="preview-date">
                    ${Icons.calendar} ${todayArabic}
                  </div>
                </div>
                <div class="preview-welcome">
                  <span>الطبيب المعالج والمستشار الطبي:</span>
                  <strong>${settings.doctorName || 'د. أحمد محمد'} ${Icons.checkCircle}</strong>
                </div>
                <div class="preview-stats">
                  <div class="preview-stat">
                    <span>سعر الكشف</span>
                    <strong>${settings.price || 100} ج.م</strong>
                  </div>
                  <div class="preview-stat">
                    <span>المتاحة اليوم</span>
                    <strong>${stats.todayAvailableCount}</strong>
                  </div>
                  <div class="preview-stat">
                    <span>طريقة الدفع</span>
                    <strong style="font-size: 13px;">فودافون كاش</strong>
                  </div>
                </div>

                <div class="preview-list">
                  <div class="preview-list__head">
                    <span>جدول مواعيد اليوم (${todayArabic})</span>
                    <span>الحالة</span>
                  </div>
                  <div class="preview-appointment">
                    <div class="preview-appointment__avatar">1</div>
                    <div class="preview-appointment__main">
                      <strong>فترة الكشف الصباحية</strong>
                      <span>جلسات كشف واستشارة باطنية</span>
                    </div>
                    <span class="preview-appointment__time">10:00 ص</span>
                  </div>
                  <div class="preview-appointment">
                    <div class="preview-appointment__avatar" style="color: #693f55; background: #f6e3eb;">2</div>
                    <div class="preview-appointment__main">
                      <strong>فترة الكشف المسائية</strong>
                      <span>متابعة وفحوصات الجهاز الهضمي</span>
                    </div>
                    <span class="preview-appointment__time">05:00 م</span>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Clinic Portals Section -->
          <section class="landing-portals" id="gsap-portals">
            <div class="portals-inner">
              <div class="portals-heading" id="gsap-portals-heading">
                <div>
                  <h2>خدمات وحجوزات عيادة ${settings.doctorName || 'د. أحمد محمد'}</h2>
                  <p>اختر الخدمة المطلوبة لحجز موعدك مع الطبيب أو الدخول للوحة إدارة العيادة.</p>
                </div>
                <div class="demo-strip">
                  <span class="dot">•</span>
                  <span>${settings.clinicName || 'عيادة الشفاء التخصصية'} — مواعيد الأسبوع الحالي متاحة</span>
                </div>
              </div>

              <div class="portal-grid">
                <!-- Patient Portal Card -->
                <div class="portal-card portal-card--patient gsap-portal-card" id="portal-card-patient" style="cursor: pointer;">
                  <div class="portal-card__top">
                    <div class="portal-icon">${Icons.calendar}</div>
                    <div class="portal-arrow">${Icons.arrowLeft}</div>
                  </div>
                  <h3>حجز موعد كشف طبي مع د. أحمد محمد</h3>
                  <p>
                    احجز موعد كشفك الآن بسهولة تامة بدون الحاجة لإنشاء حساب أو كلمة مرور. استعرض مواعيد الأسبوع الحالي المتاحة وادفع عبر محفظة فودافون كاش مع استلام إيصال حجز وتأكيد فوري.
                  </p>
                  <div class="portal-card__foot">
                    <span>احجز موعدك الآن مع الطبيب</span>
                    ${Icons.arrowLeft}
                  </div>
                </div>

                <!-- Doctor Portal Card -->
                <div class="portal-card gsap-portal-card" id="portal-card-doctor" style="cursor: pointer;">
                  <div class="portal-card__top">
                    <div class="portal-icon">${Icons.stethoscope}</div>
                    <div class="portal-arrow">${Icons.arrowLeft}</div>
                  </div>
                  <h3>لوحة إدارة العيادة (خاصة بالطبيب)</h3>
                  <p>
                    منطقة الدخول المخصصة لدكتور أحمد محمد لإدارة جدول المواعيد الأسبوعي، متابعة كشوفات اليوم، استعراض بيانات المرضى والمدفوعات المسجلة بالعيادة.
                  </p>
                  <div class="portal-card__foot">
                    <span>تسجيل دخول الطبيب</span>
                    ${Icons.arrowLeft}
                  </div>
                </div>
              </div>
            </div>
          </section>

          <footer class="landing-footer" id="gsap-footer">
            <div class="landing-footer__inner">
              <span>جميع الحقوق محفوظة © عيادة ${settings.doctorName || 'د. أحمد محمد'} — ${settings.clinicName || 'عيادة الشفاء التخصصية'}</span>
              <div class="landing-footer__links">
                <button id="footer-landing-patient">حجز موعد كشف</button>
                <button id="footer-landing-doctor">بوابة الطبيب</button>
              </div>
            </div>
          </footer>
        </div>
      `;
    },

    bindLandingEvents() {
      document.getElementById('landing-to-patient')?.addEventListener('click', () => App.navigate('patient'));
      document.getElementById('hero-patient-btn')?.addEventListener('click', () => App.navigate('patient'));
      document.getElementById('portal-card-patient')?.addEventListener('click', () => App.navigate('patient'));
      document.getElementById('footer-landing-patient')?.addEventListener('click', () => App.navigate('patient'));

      const goToDoctor = () => {
        if (Auth.isLoggedIn()) App.navigate('doctor', 'overview');
        else App.navigate('doctor-login');
      };
      document.getElementById('landing-to-doctor')?.addEventListener('click', goToDoctor);
      document.getElementById('hero-doctor-btn')?.addEventListener('click', goToDoctor);
      document.getElementById('portal-card-doctor')?.addEventListener('click', goToDoctor);
      document.getElementById('footer-landing-doctor')?.addEventListener('click', goToDoctor);

      // Launch GSAP animations after DOM is ready
      requestAnimationFrame(() => Views.initLandingAnimations());
    },

    /* ------------------------------------------------------------------ */
    /* GSAP LANDING ANIMATIONS                                              */
    /* ------------------------------------------------------------------ */
    initLandingAnimations() {
      // Guard: GSAP must be loaded
      if (typeof gsap === 'undefined') return;

      // Register ScrollTrigger
      if (typeof ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);
      }

      /* ── 1. PARTICLE SYSTEM (mouse-interactive) ───────────────────────── */
      const canvas = document.getElementById('landing-particles');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let animId;

        // ── Canvas sizing (fill the whole landing section) ──────────────
        const resize = () => {
          const landing = canvas.parentElement;
          canvas.width  = landing.offsetWidth;
          canvas.height = landing.offsetHeight;
        };
        resize();
        window.addEventListener('resize', () => { resize(); });

        // ── Mouse tracking (relative to canvas) ─────────────────────────
        const mouse = { x: canvas.width / 2, y: canvas.height / 2, active: false };
        const canvasRect = () => canvas.getBoundingClientRect();
        let _rect = canvasRect();
        window.addEventListener('resize', () => { _rect = canvasRect(); });

        canvas.parentElement.addEventListener('mousemove', e => {
          _rect = canvasRect();
          mouse.x = e.clientX - _rect.left;
          mouse.y = e.clientY - _rect.top;
          mouse.active = true;
        }, { passive: true });

        canvas.parentElement.addEventListener('mouseleave', () => {
          mouse.active = false;
        }, { passive: true });

        // ── Colour palette ───────────────────────────────────────────────
        const PALETTE = [
          [67, 201, 165],   // emerald-green
          [19, 181, 139],   // clinic-green
          [56, 119, 214],   // blue accent
          [114, 220, 193],  // mint
          [255, 255, 255],  // white
        ];

        // ── Particle class ───────────────────────────────────────────────
        class Particle {
          constructor(fromMouse = false) {
            this._fromMouse = fromMouse;
            this.reset(true, fromMouse);
          }

          reset(initial = false, fromMouse = false) {
            const [r, g, b] = PALETTE[Math.floor(Math.random() * PALETTE.length)];
            this.rgb   = `${r},${g},${b}`;

            if (fromMouse && mouse.active) {
              // Burst from cursor
              this.x = mouse.x + (Math.random() - 0.5) * 10;
              this.y = mouse.y + (Math.random() - 0.5) * 10;
            } else {
              this.x = Math.random() * canvas.width;
              this.y = initial ? Math.random() * canvas.height : canvas.height + 6;
            }

            // Intrinsic velocity (slow drift)
            const angle = Math.random() * Math.PI * 2;
            const speed = Math.random() * 0.3 + 0.05;
            this.vx    = Math.cos(angle) * speed;
            this.vy    = Math.sin(angle) * speed - 0.18; // slight upward bias

            this.r     = Math.random() * 2.4 + 0.5;
            this.mass  = this.r;                          // heavier = less affected
            this.alpha = Math.random() * 0.5 + 0.15;
            this.life  = 1;
            this.decay = Math.random() * 0.0025 + 0.0006;
            this.shape = Math.random() < 0.10 ? 'cross'
                       : Math.random() < 0.06 ? 'diamond'
                       : 'circle';
            // Trail
            this.trail = [];
            this.trailLen = Math.floor(Math.random() * 6 + 3);
          }

          applyMouse() {
            if (!mouse.active) return;
            const dx   = mouse.x - this.x;
            const dy   = mouse.y - this.y;
            const dist = Math.sqrt(dx * dx + dy * dy) || 1;

            // Attraction zone: 0–140 px
            if (dist < 140) {
              const force     = (140 - dist) / 140;      // 0→1 as dist→0
              const attract   = force * force * 0.55 / this.mass;
              this.vx += (dx / dist) * attract;
              this.vy += (dy / dist) * attract;
            }

            // Swirl / orbital tangent nudge inside 90 px
            if (dist < 90) {
              const tangentX = -dy / dist;
              const tangentY =  dx / dist;
              const swirl    = ((90 - dist) / 90) * 0.22;
              this.vx += tangentX * swirl;
              this.vy += tangentY * swirl;
            }

            // Repulsion core (don't let them pile on cursor)
            if (dist < 22) {
              this.vx -= (dx / dist) * 0.8;
              this.vy -= (dy / dist) * 0.8;
            }
          }

          clampVelocity() {
            const spd = Math.sqrt(this.vx * this.vx + this.vy * this.vy);
            const max = mouse.active ? 3.5 : 1.2;
            if (spd > max) {
              this.vx = (this.vx / spd) * max;
              this.vy = (this.vy / spd) * max;
            }
            // Friction / drag
            this.vx *= 0.97;
            this.vy *= 0.97;
          }

          update() {
            this.applyMouse();
            this.clampVelocity();

            // Store trail
            this.trail.push({ x: this.x, y: this.y });
            if (this.trail.length > this.trailLen) this.trail.shift();

            this.x    += this.vx;
            this.y    += this.vy;
            this.life -= this.decay;

            // Wrap horizontally, reset if offscreen vertically
            if (this.x < -10)              this.x = canvas.width + 10;
            if (this.x > canvas.width + 10) this.x = -10;

            if (this.life <= 0 || this.y < -30 || this.y > canvas.height + 30) {
              this.reset(false, false);
            }
          }

          draw() {
            const a = this.alpha * this.life;
            if (a <= 0) return;

            // Draw trailing smoke
            if (this.trail.length > 1) {
              for (let i = 1; i < this.trail.length; i++) {
                const t   = i / this.trail.length;
                const ta  = a * t * 0.35;
                ctx.save();
                ctx.globalAlpha = ta;
                ctx.strokeStyle = `rgba(${this.rgb},1)`;
                ctx.lineWidth   = this.r * t * 0.9;
                ctx.lineCap     = 'round';
                ctx.beginPath();
                ctx.moveTo(this.trail[i - 1].x, this.trail[i - 1].y);
                ctx.lineTo(this.trail[i].x,     this.trail[i].y);
                ctx.stroke();
                ctx.restore();
              }
            }

            ctx.save();
            ctx.globalAlpha = a;

            if (this.shape === 'cross') {
              ctx.strokeStyle = `rgba(${this.rgb},1)`;
              ctx.lineWidth   = this.r * 0.9;
              ctx.lineCap     = 'round';
              ctx.beginPath();
              ctx.moveTo(this.x - this.r * 2.2, this.y);
              ctx.lineTo(this.x + this.r * 2.2, this.y);
              ctx.moveTo(this.x, this.y - this.r * 2.2);
              ctx.lineTo(this.x, this.y + this.r * 2.2);
              ctx.stroke();

            } else if (this.shape === 'diamond') {
              ctx.fillStyle = `rgba(${this.rgb},1)`;
              ctx.beginPath();
              ctx.moveTo(this.x,            this.y - this.r * 2);
              ctx.lineTo(this.x + this.r,   this.y);
              ctx.lineTo(this.x,            this.y + this.r * 2);
              ctx.lineTo(this.x - this.r,   this.y);
              ctx.closePath();
              ctx.fill();

            } else {
              // Glowing circle
              const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.r * 2.5);
              grad.addColorStop(0,   `rgba(${this.rgb},0.9)`);
              grad.addColorStop(0.4, `rgba(${this.rgb},0.5)`);
              grad.addColorStop(1,   `rgba(${this.rgb},0)`);
              ctx.fillStyle = grad;
              ctx.beginPath();
              ctx.arc(this.x, this.y, this.r * 2.5, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.restore();
          }
        }

        // ── Mouse-burst particles pool ───────────────────────────────────
        class BurstParticle extends Particle {
          constructor() {
            super(true);
            this.r     = Math.random() * 3 + 1;
            this.mass  = 0.5;
            this.decay = Math.random() * 0.02 + 0.012;
            this.trailLen = 8;
            const angle = Math.random() * Math.PI * 2;
            const spd   = Math.random() * 2.5 + 0.5;
            this.vx = Math.cos(angle) * spd;
            this.vy = Math.sin(angle) * spd;
          }
        }

        // ── Pools ────────────────────────────────────────────────────────
        const bgParticles    = Array.from({ length: 100 }, () => new Particle(false));
        const burstParticles = Array.from({ length: 30  }, () => new BurstParticle());

        // ── Mouse cursor glow halo ───────────────────────────────────────
        const drawCursorHalo = () => {
          if (!mouse.active) return;
          const grad = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, 90);
          grad.addColorStop(0,   'rgba(67,201,165,0.10)');
          grad.addColorStop(0.5, 'rgba(67,201,165,0.04)');
          grad.addColorStop(1,   'rgba(67,201,165,0)');
          ctx.save();
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(mouse.x, mouse.y, 90, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();

          // Tiny crosshair dot at cursor
          ctx.save();
          ctx.globalAlpha = 0.55;
          ctx.fillStyle   = 'rgba(67,201,165,1)';
          ctx.beginPath();
          ctx.arc(mouse.x, mouse.y, 3, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        };

        // ── Draw web-like connection lines ───────────────────────────────
        const drawLines = () => {
          const all = [...bgParticles, ...burstParticles];
          const LINE_DIST      = 90;
          const MOUSE_LINE_DIST = 110;

          for (let i = 0; i < all.length; i++) {
            const p = all[i];

            // Particle–particle lines
            for (let j = i + 1; j < all.length; j++) {
              const q  = all[j];
              const dx = p.x - q.x, dy = p.y - q.y;
              const d  = Math.sqrt(dx * dx + dy * dy);
              if (d < LINE_DIST) {
                ctx.save();
                ctx.globalAlpha = (1 - d / LINE_DIST) * 0.075 * p.life * q.life;
                ctx.strokeStyle = `rgba(67,201,165,1)`;
                ctx.lineWidth   = 0.5;
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(q.x, q.y);
                ctx.stroke();
                ctx.restore();
              }
            }

            // Mouse–particle lines
            if (mouse.active) {
              const dx = p.x - mouse.x, dy = p.y - mouse.y;
              const d  = Math.sqrt(dx * dx + dy * dy);
              if (d < MOUSE_LINE_DIST) {
                ctx.save();
                ctx.globalAlpha = (1 - d / MOUSE_LINE_DIST) * 0.22 * p.life;
                ctx.strokeStyle = `rgba(67,201,165,1)`;
                ctx.lineWidth   = 0.8;
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(mouse.x, mouse.y);
                ctx.stroke();
                ctx.restore();
              }
            }
          }
        };

        // ── Spawn burst particles on click ───────────────────────────────
        canvas.parentElement.addEventListener('click', () => {
          if (!mouse.active) return;
          burstParticles.forEach(bp => {
            bp.x = mouse.x + (Math.random() - 0.5) * 6;
            bp.y = mouse.y + (Math.random() - 0.5) * 6;
            bp.life = 1;
            const angle = Math.random() * Math.PI * 2;
            const spd   = Math.random() * 3.5 + 1;
            bp.vx = Math.cos(angle) * spd;
            bp.vy = Math.sin(angle) * spd;
            bp.trail = [];
          });
        }, { passive: true });

        // ── Main render loop ─────────────────────────────────────────────
        const tick = () => {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          drawCursorHalo();
          drawLines();
          bgParticles.forEach(p    => { p.update();  p.draw(); });
          burstParticles.forEach(p => { p.update();  p.draw(); });
          animId = requestAnimationFrame(tick);
        };
        tick();

        // Cleanup on navigation away
        canvas._stopParticles = () => {
          cancelAnimationFrame(animId);
        };
      }

      /* ── 2. ENTRANCE TIMELINE ─────────────────────────────────────────── */
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      // Kill any existing float CSS animations so GSAP owns them
      document.querySelectorAll('.float-card').forEach(el => {
        el.style.animation = 'none';
      });

      // Set initial hidden states
      gsap.set('#gsap-header',         { y: -80, opacity: 0 });
      gsap.set('#gsap-brand',          { x: 40, opacity: 0 });
      gsap.set('#gsap-header-actions', { x: -40, opacity: 0 });
      gsap.set('#gsap-eyebrow',        { y: 30, opacity: 0, scale: 0.85 });
      gsap.set('#gsap-title',          { y: 50, opacity: 0 });
      gsap.set('#gsap-lead',           { y: 30, opacity: 0 });
      gsap.set('#gsap-actions',        { y: 25, opacity: 0 });
      gsap.set('#gsap-trust',          { y: 20, opacity: 0 });
      gsap.set('#gsap-ring1, #gsap-ring2, #gsap-ring3', { scale: 0, opacity: 0, transformOrigin: '50% 50%' });
      gsap.set('#gsap-prev-glow',      { scale: 0.5, opacity: 0 });
      gsap.set('#gsap-preview',        { y: 60, opacity: 0, rotate: 1.2, scale: 0.92 });
      gsap.set('#gsap-float-doc',      { x: -50, y: 20, opacity: 0, scale: 0.8 });
      gsap.set('#gsap-float-avail',    { x: 50, y: 20, opacity: 0, scale: 0.8 });
      gsap.set('.landing-orb',         { scale: 0, opacity: 0 });
      gsap.set('.landing-grid-bg',     { opacity: 0 });

      // Build the timeline
      tl
        // Orbs sweep in
        .to('.landing-grid-bg', { opacity: 1, duration: 1.2 }, 0)
        .to('.landing-orb--1',  { scale: 1, opacity: 1, duration: 2, ease: 'power2.out' }, 0.1)
        .to('.landing-orb--2',  { scale: 1, opacity: 1, duration: 2, ease: 'power2.out' }, 0.25)
        .to('.landing-orb--3',  { scale: 1, opacity: 1, duration: 2, ease: 'power2.out' }, 0.35)

        // Header slides down
        .to('#gsap-header', { y: 0, opacity: 1, duration: 0.7, ease: 'back.out(1.4)' }, 0.2)
        .to('#gsap-brand',  { x: 0, opacity: 1, duration: 0.6 }, 0.35)
        .to('#gsap-header-actions', { x: 0, opacity: 1, duration: 0.6 }, 0.4)

        // Eyebrow badge bounces in
        .to('#gsap-eyebrow', { y: 0, opacity: 1, scale: 1, duration: 0.65, ease: 'back.out(2)' }, 0.55)

        // Title reveals
        .to('#gsap-title', { y: 0, opacity: 1, duration: 0.85, ease: 'power4.out' }, 0.72)

        // Lead paragraph
        .to('#gsap-lead', { y: 0, opacity: 1, duration: 0.7 }, 0.95)

        // CTA buttons pop in with elastic
        .to('#gsap-actions', { y: 0, opacity: 1, duration: 0.6, ease: 'back.out(1.6)' }, 1.1)

        // Trust bar
        .to('#gsap-trust', { y: 0, opacity: 1, duration: 0.5 }, 1.28)

        // Rings expand
        .to('#gsap-ring3', { scale: 1, opacity: 1, duration: 1.1, ease: 'elastic.out(1, 0.5)' }, 0.5)
        .to('#gsap-ring2', { scale: 1, opacity: 1, duration: 1.2, ease: 'elastic.out(1, 0.6)' }, 0.62)
        .to('#gsap-ring1', { scale: 1, opacity: 1, duration: 1.3, ease: 'elastic.out(1, 0.65)' }, 0.74)

        // Glow pulses in
        .to('#gsap-prev-glow', { scale: 1, opacity: 1, duration: 1.5, ease: 'power2.out' }, 0.7)

        // Preview card flies in
        .to('#gsap-preview', { y: 0, opacity: 1, rotate: 1.2, scale: 1, duration: 1, ease: 'back.out(1.3)' }, 0.85)

        // Float cards slide in from sides
        .to('#gsap-float-doc',   { x: 0, y: 0, opacity: 1, scale: 1, duration: 0.8, ease: 'back.out(1.7)' }, 1.05)
        .to('#gsap-float-avail', { x: 0, y: 0, opacity: 1, scale: 1, duration: 0.8, ease: 'back.out(1.7)' }, 1.18)

        // Scan line on preview card
        .fromTo('#gsap-scan',
          { top: 18, opacity: 0 },
          { top: '90%', opacity: 0.7, duration: 2, ease: 'power1.inOut', repeat: -1, yoyo: false },
          1.6
        );

      /* ── 3. CONTINUOUS ORBIT ANIMATION ────────────────────────────────── */
      // Ring 1 slow spin + dot orbit
      gsap.to('#gsap-ring1', { rotation: 360, duration: 30, ease: 'none', repeat: -1, transformOrigin: '50% 50%' });
      gsap.to('#gsap-ring3', { rotation: -360, duration: 22, ease: 'none', repeat: -1, transformOrigin: '50% 50%' });

      // Orbiting dot on ring 1
      const ring1El = document.getElementById('gsap-ring1');
      const dotEl   = document.getElementById('gsap-dot1');
      if (ring1El && dotEl) {
        gsap.to(dotEl, {
          motionPath: {
            path: [
              { x: 280, y: 0 },
              { x: 0,   y: 280 },
              { x: -280, y: 0 },
              { x: 0,   y: -280 },
              { x: 280, y: 0 },
            ],
          },
          duration: 8,
          ease: 'none',
          repeat: -1,
          transformOrigin: '50% 50%',
        });
      }

      /* ── 4. CONTINUOUS FLOAT ANIMATIONS ──────────────────────────────── */
      gsap.to('#gsap-float-doc', {
        y: -10, duration: 3.2, ease: 'sine.inOut', repeat: -1, yoyo: true,
      });
      gsap.to('#gsap-float-avail', {
        y: 10, duration: 2.8, ease: 'sine.inOut', repeat: -1, yoyo: true, delay: 1.2,
      });

      /* ── 5. GLOW PULSE ────────────────────────────────────────────────── */
      gsap.to('#gsap-prev-glow', {
        scale: 1.12, opacity: 0.7, duration: 3, ease: 'sine.inOut', repeat: -1, yoyo: true,
      });

      /* ── 6. ORB DRIFT ─────────────────────────────────────────────────── */
      gsap.to('.landing-orb--1', { x: 40, y: -30, duration: 8,  ease: 'sine.inOut', repeat: -1, yoyo: true });
      gsap.to('.landing-orb--2', { x: -30, y: 25, duration: 9,  ease: 'sine.inOut', repeat: -1, yoyo: true, delay: 2 });
      gsap.to('.landing-orb--3', { x: 20,  y: -20, duration: 7, ease: 'sine.inOut', repeat: -1, yoyo: true, delay: 1 });

      /* ── 7. SCROLL-TRIGGERED PORTAL CARDS ───────────────────────────── */
      if (typeof ScrollTrigger !== 'undefined') {
        const portalsEl = document.getElementById('gsap-portals');
        if (portalsEl) {
          gsap.set('.gsap-portal-card', { y: 60, opacity: 0, scale: 0.92 });
          gsap.set('#gsap-portals-heading', { y: 40, opacity: 0 });

          gsap.to('#gsap-portals-heading', {
            y: 0, opacity: 1, duration: 0.8,
            scrollTrigger: { trigger: portalsEl, start: 'top 82%', toggleActions: 'play none none none' },
          });

          gsap.to('.gsap-portal-card', {
            y: 0, opacity: 1, scale: 1, duration: 0.75, stagger: 0.18, ease: 'back.out(1.5)',
            scrollTrigger: { trigger: portalsEl, start: 'top 75%', toggleActions: 'play none none none' },
          });

          gsap.to('#gsap-footer', {
            opacity: 1, duration: 0.6,
            scrollTrigger: { trigger: '#gsap-footer', start: 'top 95%', toggleActions: 'play none none none' },
          });
        }
      }

      /* ── 8. PORTAL CARD MAGNETIC HOVER ──────────────────────────────── */
      document.querySelectorAll('.gsap-portal-card').forEach(card => {
        card.addEventListener('mousemove', e => {
          const rect = card.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = (e.clientX - cx) / (rect.width / 2);
          const dy = (e.clientY - cy) / (rect.height / 2);
          gsap.to(card, {
            rotateX: -dy * 5,
            rotateY: dx * 5,
            transformPerspective: 800,
            ease: 'power2.out',
            duration: 0.4,
          });
        });
        card.addEventListener('mouseleave', () => {
          gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
        });
      });

      /* ── 9. BUTTON HOVER PULSE ───────────────────────────────────────── */
      document.querySelectorAll('#hero-patient-btn, #landing-to-patient').forEach(btn => {
        btn.addEventListener('mouseenter', () => {
          gsap.to(btn, { scale: 1.05, duration: 0.25, ease: 'back.out(2)' });
        });
        btn.addEventListener('mouseleave', () => {
          gsap.to(btn, { scale: 1, duration: 0.35, ease: 'elastic.out(1, 0.5)' });
        });
      });

      /* ── 10. HEADER SCROLL GLASS EFFECT ─────────────────────────────── */
      const header = document.querySelector('.landing-header-wrap');
      if (header) {
        const onScroll = () => {
          const scrolled = window.scrollY > 40;
          gsap.to(header, {
            backgroundColor: scrolled ? 'rgba(6,24,38,0.88)' : 'rgba(6,24,38,0)',
            backdropFilter: scrolled ? 'blur(18px)' : 'blur(0px)',
            borderBottomColor: scrolled ? 'rgba(255,255,255,0.1)' : 'rgba(255,255,255,0.075)',
            duration: 0.4,
            ease: 'power2.out',
          });
        };
        const landing = document.querySelector('.landing');
        landing?.addEventListener('scroll', onScroll, { passive: true });
        document.addEventListener('scroll', onScroll, { passive: true });
      }
    },

    /* ---------------- DOCTOR LOGIN ---------------- */
    DoctorLogin() {
      const settings = ClinicEngine.getSettings();
      return `
        <div class="auth-page">
          <div class="auth-panel">
            <div class="auth-top-link">
              <button class="auth-back" id="login-back-to-landing">
                ${Icons.chevronRight} العودة لموقع العيادة
              </button>
            </div>

            <div class="auth-card">
              <div class="auth-brand">
                <div class="brand-mark brand-mark--lg">
                  <svg viewBox="0 0 64 64" fill="none"><path d="M12 34h11l6-17 9 31 6-22 4 8h9" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="brand-word">
                  <strong>${settings.doctorName || 'د. أحمد محمد'}</strong>
                  <span>${settings.clinicName || 'عيادة الشفاء التخصصية'}</span>
                </div>
              </div>

              <div class="auth-welcome">مرحباً بك د. أحمد محمد</div>
              <h1 class="auth-title">تسجيل دخول الطبيب</h1>
              <p class="auth-subtitle">أدخل بيانات الحساب لإدارة جدول المواعيد وكشوفات المرضى.</p>

              <div class="auth-error" id="auth-error-msg">
                ${Icons.alert}
                <span id="auth-error-text">اسم المستخدم أو كلمة المرور غير صحيحة.</span>
              </div>

              <form class="auth-form" id="doctor-login-form">
                <div class="field">
                  <label for="doctor-username">اسم المستخدم</label>
                  <input type="text" id="doctor-username" class="input" placeholder="أدخل اسم المستخدم" required autocomplete="username" value="doctor">
                </div>

                <div class="field">
                  <label for="doctor-password">كلمة المرور</label>
                  <div style="position: relative; display: flex; align-items: center;">
                    <input type="password" id="doctor-password" class="input" placeholder="••••••••" required autocomplete="current-password" value="Doctor@123" style="width: 100%; padding-left: 42px;">
                    <button type="button" id="toggle-password-btn" style="position: absolute; left: 12px; background: none; border: 0; color: #7b8a99; cursor: pointer; padding: 4px;" title="إظهار / إخفاء كلمة المرور">
                      ${Icons.eye}
                    </button>
                  </div>
                </div>

                <div class="auth-options">
                  <label style="display: flex; align-items: center; gap: 7px; font-size: 11.5px; cursor: pointer;">
                    <input type="checkbox" id="remember-me" checked>
                    <span>تذكّر تسجيل الدخول</span>
                  </label>
                </div>

                <button type="submit" class="btn btn--accent auth-submit">
                  ${Icons.lock} تسجيل الدخول للوحة التحكم
                </button>
              </form>

              <div class="auth-demo">
                <div class="auth-demo__head">
                  ${Icons.info} بيانات الدخول التجريبية الخاصة بالطبيب:
                </div>
                <div class="auth-demo__body">
                  <span>اسم المستخدم: <code>doctor</code></span>
                  <span>كلمة المرور: <code>Doctor@123</code></span>
                </div>
              </div>

              <div class="auth-security-note">
                ${Icons.shield}
                <span>ملاحظة: هذا نموذج أولي تجريبي يعمل على المتصفح عبر التخزين المحلي (LocalStorage).</span>
              </div>
            </div>
          </div>

          <div class="auth-visual">
            <div class="auth-visual__top">
              <span class="badge badge--green">${settings.clinicName || 'عيادة الشفاء التخصصية'}</span>
            </div>
            <div style="max-width: 440px;">
              <h2 style="font-size: 28px; font-weight: 800; line-height: 1.4; color: #fff;">
                عيادة ${settings.doctorName || 'د. أحمد محمد'}
              </h2>
              <p style="margin-top: 10px; color: rgba(255,255,255,0.7); font-size: 13.5px; line-height: 1.8;">
                ${settings.specialty || 'استشاري طب الباطنة والجهاز الهضمي'} — تحكم بالجدول الأسبوعي للعيادة، تابع كشوفات اليوم، واستعرض سجلات المرضى والمدفوعات بكل سهولة ودقة.
              </p>
            </div>
            <div style="font-size: 11px; color: rgba(255,255,255,0.4);">
              جميع الحقوق محفوظة © عيادة ${settings.doctorName || 'د. أحمد محمد'}
            </div>
          </div>
        </div>
      `;
    },

    bindDoctorLoginEvents() {
      document.getElementById('login-back-to-landing')?.addEventListener('click', () => App.navigate('landing'));

      const passInput = document.getElementById('doctor-password');
      const toggleBtn = document.getElementById('toggle-password-btn');
      if (toggleBtn && passInput) {
        toggleBtn.addEventListener('click', () => {
          if (passInput.type === 'password') {
            passInput.type = 'text';
            toggleBtn.innerHTML = Icons.eyeOff;
          } else {
            passInput.type = 'password';
            toggleBtn.innerHTML = Icons.eye;
          }
        });
      }

      const form = document.getElementById('doctor-login-form');
      const errorBox = document.getElementById('auth-error-msg');
      const errorText = document.getElementById('auth-error-text');

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const username = document.getElementById('doctor-username').value;
        const password = passInput.value;
        const remember = document.getElementById('remember-me')?.checked ?? true;

        const res = Auth.login(username, password, remember);
        if (res.success) {
          showToast('مرحباً بك دكتور', 'تم تسجيل الدخول بنجاح.', 'success');
          App.navigate('doctor', 'overview');
        } else {
          if (errorBox) {
            errorBox.classList.add('is-visible');
            if (errorText) errorText.textContent = res.error;
          }
        }
      });
    },

    /* ---------------- DOCTOR SHELL & SUBVIEWS ---------------- */
    DoctorShell(activeSubView = 'overview') {
      const settings = ClinicEngine.getSettings();
      const stats = ClinicEngine.getDashboardStats();
      const todayArabic = DateHelper.formatDateArabic(DateHelper.todayISO());

      let subViewTitle = 'الرئيسية';
      if (activeSubView === 'schedule') subViewTitle = 'جدول المواعيد الأسبوعي';
      if (activeSubView === 'today') subViewTitle = 'حجوزات اليوم';
      if (activeSubView === 'all-bookings') subViewTitle = 'جميع الحجوزات';
      if (activeSubView === 'settings') subViewTitle = 'إعدادات العيادة والحساب';

      let contentHtml = '';
      if (activeSubView === 'overview') contentHtml = Views.DoctorOverview();
      else if (activeSubView === 'schedule') contentHtml = Views.DoctorSchedule();
      else if (activeSubView === 'today') contentHtml = Views.DoctorToday();
      else if (activeSubView === 'all-bookings') contentHtml = Views.DoctorAllBookings();
      else if (activeSubView === 'settings') contentHtml = Views.DoctorSettings();

      return `
        <div class="doctor-shell">
          <!-- Sidebar -->
          <aside class="doctor-sidebar" id="doctor-sidebar">
            <div class="sidebar-inner">
              <div class="sidebar-brand">
                <div class="brand brand--inverse">
                  <div class="brand-mark">
                    <svg viewBox="0 0 64 64" fill="none"><path d="M12 34h11l6-17 9 31 6-22 4 8h9" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                  <div class="brand-word">
                    <strong>نبض</strong>
                    <span>لوحة تحكم الطبيب</span>
                  </div>
                </div>
                <button class="btn btn--icon sidebar-close" id="sidebar-close-btn">${Icons.x}</button>
              </div>

              <div class="sidebar-doctor-card">
                <div class="doctor-avatar">د</div>
                <div class="doctor-card-info">
                  <strong>${settings.doctorName || 'د. أحمد محمد'}</strong>
                  <span>${settings.specialty || 'طب الباطنة'}</span>
                </div>
              </div>

              <div class="sidebar-section-label">القائمة الرئيسية</div>
              <nav class="sidebar-nav">
                <button class="nav-link ${activeSubView === 'overview' ? 'is-active' : ''}" data-nav="overview">
                  ${Icons.home} <span>الرئيسية</span>
                </button>
                <button class="nav-link ${activeSubView === 'schedule' ? 'is-active' : ''}" data-nav="schedule">
                  ${Icons.calendar} <span>جدول المواعيد</span>
                </button>
                <button class="nav-link ${activeSubView === 'today' ? 'is-active' : ''}" data-nav="today">
                  ${Icons.clock} <span>حجوزات اليوم</span>
                  <span class="nav-link__badge">${stats.todayBookingsCount}</span>
                </button>
                <button class="nav-link ${activeSubView === 'all-bookings' ? 'is-active' : ''}" data-nav="all-bookings">
                  ${Icons.list} <span>جميع الحجوزات</span>
                </button>
                <button class="nav-link ${activeSubView === 'settings' ? 'is-active' : ''}" data-nav="settings">
                  ${Icons.settings} <span>الإعدادات</span>
                </button>
              </nav>

              <div class="sidebar-spacer"></div>

              <div class="sidebar-help">
                <div class="sidebar-help__head">${Icons.sparkles} بوابة المرضى جاهزة</div>
                <p>يمكنك فتح بوابة المرضى وتجربة الحجز كـ مريض في أي وقت.</p>
                <button class="btn btn--sm btn--outline" id="sidebar-open-patient" style="width: 100%; margin-top: 8px; font-size: 10px; border-color: rgba(255,255,255,0.2); color: #fff;">
                  ${Icons.arrowLeft} تجربة حجز موعد
                </button>
              </div>

              <div class="sidebar-footer">
                <button class="sidebar-logout" id="doctor-logout-btn">
                  ${Icons.logout} <span>تسجيل الخروج</span>
                </button>
              </div>
            </div>
          </aside>

          <!-- Main Content Area -->
          <div class="doctor-main">
            <!-- Topbar -->
            <header class="doctor-topbar">
              <div class="topbar-right">
                <button class="btn btn--icon sidebar-toggle" id="sidebar-toggle-btn">${Icons.list}</button>
                <div class="topbar-breadcrumb">
                  <span>لوحة الطبيب</span>
                  ${Icons.chevronLeft}
                  <strong>${subViewTitle}</strong>
                </div>
              </div>

              <div class="topbar-left">
                <div class="topbar-date">
                  ${Icons.calendar} <span>${todayArabic}</span>
                </div>
                <button class="btn btn--sm btn--outline topbar-patient-link" id="topbar-patient-btn">
                  ${Icons.calendar} بوابة حجز المرضى
                </button>
              </div>
            </header>

            <!-- Page Container -->
            <main class="doctor-content">
              ${contentHtml}
            </main>
          </div>
        </div>
      `;
    },

    bindDoctorShellEvents(activeSubView) {
      // Sidebar navigation
      document.querySelectorAll('.nav-link').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-nav');
          App.navigate('doctor', target);
        });
      });

      // Quick patient portal buttons
      document.getElementById('sidebar-open-patient')?.addEventListener('click', () => App.navigate('patient'));
      document.getElementById('topbar-patient-btn')?.addEventListener('click', () => App.navigate('patient'));

      // Logout button
      document.getElementById('doctor-logout-btn')?.addEventListener('click', () => {
        Modals.openLogoutConfirm();
      });

      // Mobile sidebar toggle
      const sidebar = document.getElementById('doctor-sidebar');
      const toggleBtn = document.getElementById('sidebar-toggle-btn');
      const closeBtn = document.getElementById('sidebar-close-btn');

      toggleBtn?.addEventListener('click', () => sidebar?.classList.toggle('is-open'));
      closeBtn?.addEventListener('click', () => sidebar?.classList.remove('is-open'));

      // Bind subview specific events
      if (activeSubView === 'overview') Views.bindDoctorOverviewEvents();
      else if (activeSubView === 'schedule') Views.bindDoctorScheduleEvents();
      else if (activeSubView === 'today') Views.bindDoctorTodayEvents();
      else if (activeSubView === 'all-bookings') Views.bindDoctorAllBookingsEvents();
      else if (activeSubView === 'settings') Views.bindDoctorSettingsEvents();
    },

    /* ---------------- DOCTOR SUBVIEWS ---------------- */
    DoctorOverview() {
      const settings = ClinicEngine.getSettings();
      const stats = ClinicEngine.getDashboardStats();
      const todayArabic = DateHelper.formatDateArabic(DateHelper.todayISO());

      let todayAppointmentsRows = '';
      if (stats.todayBookingsList.length === 0) {
        todayAppointmentsRows = `
          <div class="empty-state empty-state--compact">
            <div class="empty-state__art">${Icons.calendar}</div>
            <h3>لا توجد حجوزات مسجلة اليوم حتى الآن</h3>
            <p>جميع المواعيد المتاحة بانتظار حجز المرضى أو يمكنك إضافة موعد يدويًا.</p>
            <button class="btn btn--sm btn--accent" id="overview-add-slot-btn">${Icons.plus} إضافة جلسة جديدة</button>
          </div>
        `;
      } else {
        todayAppointmentsRows = stats.todayBookingsList.map(b => `
          <div class="appointment-row" data-booking-id="${b.id}">
            <div class="appointment-time">
              <strong>${DateHelper.formatTimeArabic(b.startTime)}</strong>
              <span>إلى ${DateHelper.formatTimeArabic(b.endTime)}</span>
            </div>
            <div class="appointment-patient">
              <div class="patient-avatar">${b.patientName.charAt(0) || 'م'}</div>
              <div class="patient-main">
                <strong>${b.patientName}</strong>
                <span>${Icons.phone} ${b.patientPhone}</span>
              </div>
            </div>
            <div class="appointment-side">
              <span class="badge badge--green">${b.paymentStatus === 'paid' ? 'مدفوع' : 'معلق'}</span>
              <span class="badge badge--navy">${b.bookingStatus === 'confirmed' ? 'مؤكد' : b.bookingStatus === 'completed' ? 'مكتمل' : 'ملغي'}</span>
              <button class="row-chevron view-booking-btn" data-id="${b.id}" title="عرض التفاصيل">
                ${Icons.chevronLeft}
              </button>
            </div>
          </div>
        `).join('');
      }

      // Next appointment widget
      let nextAppointmentHtml = '';
      if (stats.nextAppointment) {
        nextAppointmentHtml = `
          <div class="next-appointment">
            <span class="badge badge--green" style="margin-bottom: 8px;">الموعد التالي القادم</span>
            <div style="font-size: 20px; font-weight: 800; color: #fff;">
              ${DateHelper.formatTimeArabic(stats.nextAppointment.startTime)}
            </div>
            <div style="margin-top: 6px; font-size: 13px; font-weight: 700;">
              ${stats.nextAppointment.patientName}
            </div>
            <div style="margin-top: 2px; font-size: 11px; color: rgba(255,255,255,0.7); display: flex; align-items: center; gap: 4px;">
              ${Icons.phone} ${stats.nextAppointment.patientPhone}
            </div>
            <button class="btn btn--sm btn--outline view-booking-btn" data-id="${stats.nextAppointment.id}" style="margin-top: 15px; width: 100%; border-color: rgba(255,255,255,0.25); color: #fff;">
              عرض ملف الحجز
            </button>
          </div>
        `;
      } else {
        nextAppointmentHtml = `
          <div class="next-appointment">
            <span class="badge badge--gray" style="margin-bottom: 8px;">حالة المواعيد</span>
            <div style="font-size: 16px; font-weight: 800; color: #fff;">لا توجد مواعيد متبقية اليوم</div>
            <p style="margin-top: 6px; font-size: 11px; color: rgba(255,255,255,0.7);">
              يمكنك الاطلاع على الجدول الأسبوعي أو إضافة جلسات عمل إضافية.
            </p>
            <button class="btn btn--sm btn--outline" id="overview-go-schedule" style="margin-top: 15px; width: 100%; border-color: rgba(255,255,255,0.25); color: #fff;">
              الانتقال للجدول
            </button>
          </div>
        `;
      }

      return `
        <div class="page-heading">
          <div class="page-heading__copy">
            <div class="page-kicker">
              <span class="dot">•</span> مرحباً، ${settings.doctorName || 'د. أحمد محمد'}
            </div>
            <h1>لوحة المتابعة اليومية</h1>
            <p>إليك ملخص حي لحجوزات العيادة وجدول المواعيد ليوم ${todayArabic}</p>
          </div>
          <div class="page-heading__actions">
            <button class="btn btn--accent" id="overview-add-slot-top">${Icons.plus} إضافة موعد جديد</button>
            <button class="btn btn--outline" id="overview-schedule-top">${Icons.calendar} تعديل الجدول الأسبوعي</button>
          </div>
        </div>

        <!-- 5 Live Stat Cards -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-top">
              <div class="stat-icon" style="--stat-color: var(--green-700); --stat-tint: var(--green-50);">${Icons.clock}</div>
              <span class="stat-trend">${Icons.calendar} اليوم</span>
            </div>
            <div class="stat-value">${stats.todayBookingsCount} <small>حجز</small></div>
            <div class="stat-label">حجوزات اليوم</div>
            <div class="stat-meta">مؤكدة ومسجلة في جدول اليوم</div>
          </div>

          <div class="stat-card">
            <div class="stat-top">
              <div class="stat-icon" style="--stat-color: #0b9b78; --stat-tint: #edfaf6;">${Icons.checkCircle}</div>
              <span class="stat-trend">متاح</span>
            </div>
            <div class="stat-value">${stats.todayAvailableCount} <small>جلسة</small></div>
            <div class="stat-label">الجلسات المتاحة اليوم</div>
            <div class="stat-meta">جاهزة لحجز المرضى فوراً</div>
          </div>

          <div class="stat-card">
            <div class="stat-top">
              <div class="stat-icon" style="--stat-color: #3877d6; --stat-tint: #eef5ff;">${Icons.user}</div>
              <span class="stat-trend">محجوز</span>
            </div>
            <div class="stat-value">${stats.todayBookedCount} <small>جلسة</small></div>
            <div class="stat-label">الجلسات المحجوزة اليوم</div>
            <div class="stat-meta">تم حجزها من قِبل المرضى</div>
          </div>

          <div class="stat-card">
            <div class="stat-top">
              <div class="stat-icon" style="--stat-color: #7557c8; --stat-tint: #f4f0ff;">${Icons.calendar}</div>
              <span class="stat-trend">قادمة</span>
            </div>
            <div class="stat-value">${stats.upcomingCount} <small>موعد</small></div>
            <div class="stat-label">الحجوزات القادمة</div>
            <div class="stat-meta">إجمالي المواعيد المؤكدة</div>
          </div>

          <div class="stat-card stat-card--highlight">
            <div class="stat-top">
              <div class="stat-icon">${Icons.cash}</div>
              <span class="stat-trend">${Icons.check} مسجل</span>
            </div>
            <div class="stat-value">${stats.totalRevenue} <small>ج.م</small></div>
            <div class="stat-label">إجمالي المدفوعات</div>
            <div class="stat-meta">فودافون كاش (محاكاة فورية)</div>
          </div>
        </div>

        <div class="dashboard-grid">
          <div class="dashboard-stack">
            <!-- Today's Appointments Panel -->
            <div class="panel">
              <div class="panel-head">
                <div>
                  <div class="panel-title">${Icons.clock} قائمة حجوزات اليوم (${stats.todayBookingsCount})</div>
                  <div class="panel-subtitle">جميع المرضى المسجلين لكشف اليوم حسب التوقيت</div>
                </div>
                <div class="panel-head-actions">
                  <button class="btn btn--sm btn--outline" id="overview-view-all-today">${Icons.list} جدول اليوم كامل</button>
                </div>
              </div>

              <div class="appointment-list">
                ${todayAppointmentsRows}
              </div>

              <div class="panel-foot">
                <span>سعر كشف العيادة: <strong>${settings.price} ج.م</strong></span>
                <button class="btn btn--ghost btn--sm" id="overview-foot-schedule">${Icons.calendar} تعديل فترات العمل</button>
              </div>
            </div>
          </div>

          <div class="dashboard-stack">
            <!-- Highlight Next Appointment -->
            ${nextAppointmentHtml}

            <!-- Quick info card -->
            <div class="panel" style="padding: 16px;">
              <div style="font-weight: 800; font-size: 13px; color: var(--navy-900); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                ${Icons.info} تفضيلات الجدولة
              </div>
              <div style="font-size: 11px; color: var(--muted); line-height: 1.8;">
                <div>أول أيام الأسبوع: <strong>${DateHelper.getDayName(settings.firstDayOfWeek || 'sat')}</strong></div>
                <div>المدة الافتراضية للجلسة: <strong>${settings.defaultDuration || 30} دقيقة</strong></div>
                <div>طريقة الدفع للمرضى: <strong>فودافون كاش</strong></div>
              </div>
            </div>
          </div>
        </div>
      `;
    },

    bindDoctorOverviewEvents() {
      document.getElementById('overview-add-slot-top')?.addEventListener('click', () => {
        Modals.openAddSlotModal(DateHelper.todayISO());
      });
      document.getElementById('overview-add-slot-btn')?.addEventListener('click', () => {
        Modals.openAddSlotModal(DateHelper.todayISO());
      });
      document.getElementById('overview-schedule-top')?.addEventListener('click', () => App.navigate('doctor', 'schedule'));
      document.getElementById('overview-view-all-today')?.addEventListener('click', () => App.navigate('doctor', 'today'));
      document.getElementById('overview-foot-schedule')?.addEventListener('click', () => App.navigate('doctor', 'schedule'));
      document.getElementById('overview-go-schedule')?.addEventListener('click', () => App.navigate('doctor', 'schedule'));

      // View booking details buttons
      document.querySelectorAll('.view-booking-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const bookingId = btn.getAttribute('data-id');
          Modals.openBookingDetailsModal(bookingId);
        });
      });
    },

    /* ---------------- WEEKLY SCHEDULE MANAGEMENT ---------------- */
    DoctorSchedule() {
      const settings = ClinicEngine.getSettings();
      const firstDayKey = settings.firstDayOfWeek || 'sat';
      const weekDates = DateHelper.getCurrentWeekDates(firstDayKey);

      // Current selected date in state or default to today (or first day of week)
      let selectedIso = App._scheduleSelectedDate;
      if (!selectedIso || !weekDates.some(w => w.iso === selectedIso)) {
        selectedIso = DateHelper.todayISO();
        if (!weekDates.some(w => w.iso === selectedIso)) {
          selectedIso = weekDates[0].iso;
        }
        App._scheduleSelectedDate = selectedIso;
      }

      const selectedDateObj = DateHelper.fromISODate(selectedIso);
      const selectedDayKey = DateHelper.getDayKey(selectedDateObj);
      const selectedDayName = DateHelper.getDayName(selectedDayKey);
      const slots = ClinicEngine.getScheduleForDate(selectedIso);

      // Render week strip
      const weekStripHtml = weekDates.map(w => {
        const isSelected = w.iso === selectedIso;
        const daySlots = ClinicEngine.getScheduleForDate(w.iso);
        const bookedCount = daySlots.filter(s => s.status === 'booked').length;
        const totalCount = daySlots.length;

        return `
          <button class="week-day ${isSelected ? 'is-selected' : ''} ${w.isToday ? 'is-today' : ''}" data-iso="${w.iso}">
            <span class="week-day__name">${w.dayName}</span>
            <span class="week-day__num">${w.dayNum}</span>
            <span class="week-day__meta">
              <span class="dot"></span> ${bookedCount}/${totalCount}
            </span>
          </button>
        `;
      }).join('');

      // Render slots list
      let slotListHtml = '';
      if (slots.length === 0) {
        slotListHtml = `
          <div class="empty-state empty-state--compact">
            <div class="empty-state__art">${Icons.calendar}</div>
            <h3>لا توجد جلسات عمل مجدولة لهذا اليوم (${selectedDayName})</h3>
            <p>أضف جلسات عمل متكررة أسبوعياً أو خاصة بهذا التاريخ لتمكين المرضى من الحجز.</p>
            <button class="btn btn--accent btn--sm" id="schedule-empty-add-btn">${Icons.plus} إضافة جلسة جديدة</button>
          </div>
        `;
      } else {
        slotListHtml = slots.map(slot => {
          let cardClass = 'slot-card--available';
          let badgeHtml = '<span class="badge badge--green">متاح للحجز</span>';

          if (slot.status === 'booked') {
            cardClass = 'slot-card--booked';
            badgeHtml = '<span class="badge badge--navy">محجوز</span>';
          } else if (slot.status === 'past') {
            cardClass = 'slot-card--past';
            badgeHtml = '<span class="badge badge--gray">انتهى وقته</span>';
          }

          let extraMeta = '';
          if (slot.booking) {
            extraMeta = `
              <span class="slot-title">${slot.booking.patientName}</span>
              <div class="slot-sub">
                <span>${Icons.phone} ${slot.booking.patientPhone}</span>
                <span>${Icons.cash} ${slot.booking.amount} ج.م</span>
                <span>كود: ${slot.booking.id}</span>
              </div>
            `;
          } else {
            extraMeta = `
              <span class="slot-title">جلسة كشف عادية</span>
              <div class="slot-sub">
                <span>المدة: ${settings.defaultDuration || 30} دقيقة</span>
                <span>${slot.isOverride ? 'تعديل استثنائي لهذا اليوم' : 'جدول متكرر أسبوعياً'}</span>
              </div>
            `;
          }

          let actionButtons = '';
          if (slot.booking) {
            actionButtons = `
              <button class="btn btn--sm btn--outline view-booking-btn" data-id="${slot.booking.id}" title="عرض تفاصيل الحجز">
                ${Icons.user} تفاصيل الحجز
              </button>
            `;
          } else {
            actionButtons = `
              <button class="icon-btn edit-slot-btn" data-id="${slot.id}" data-start="${slot.startTime}" data-end="${slot.endTime}" title="تعديل وقت الجلسة">
                ${Icons.edit}
              </button>
              <button class="icon-btn icon-btn--danger delete-slot-btn" data-id="${slot.id}" data-start="${slot.startTime}" data-end="${slot.endTime}" title="حذف الجلسة">
                ${Icons.trash}
              </button>
            `;
          }

          return `
            <div class="slot-card ${cardClass}">
              <div class="slot-time-block">
                <strong>${slot.formattedStart}</strong>
                <span>إلى ${slot.formattedEnd}</span>
              </div>
              <div class="slot-body">
                <div class="slot-statusline">
                  ${badgeHtml}
                </div>
                ${extraMeta}
              </div>
              <div class="slot-actions">
                ${actionButtons}
              </div>
            </div>
          `;
        }).join('');
      }

      return `
        <div class="page-heading schedule-page-head">
          <div class="page-heading__copy">
            <div class="page-kicker"><span class="dot">•</span> إدارة المواعيد الدورية</div>
            <h1>جدول المواعيد الأسبوعي</h1>
            <p>قم بضبط وإضافة الجلسات لكل يوم من أيام الأسبوع، مع إمكانية التعديل على هذا التاريخ فقط أو تعميمه أسبوعياً.</p>
          </div>
          <div class="page-heading__actions">
            <button class="btn btn--accent" id="schedule-add-slot-main">
              ${Icons.plus} إضافة جلسة جديدة لهذا اليوم
            </button>
          </div>
        </div>

        <div class="schedule-layout">
          <div class="schedule-main">
            <!-- Week Strip Card -->
            <div class="week-card">
              <div class="week-card-head">
                <div class="week-range">
                  <div class="week-range__icon">${Icons.calendar}</div>
                  <div>
                    <strong>الأسبوع الحالي (${DateHelper.formatDateArabic(weekDates[0].iso, false)} - ${DateHelper.formatDateArabic(weekDates[6].iso, false)})</strong>
                    <span>أول أيام الأسبوع المعتمد في الإعدادات: ${DateHelper.getDayName(firstDayKey)}</span>
                  </div>
                </div>
              </div>

              <div class="week-strip">
                ${weekStripHtml}
              </div>
            </div>

            <!-- Day Panel -->
            <div class="day-panel">
              <div class="day-panel-head">
                <div>
                  <h2>
                    ${Icons.clock} جلسات ${DateHelper.formatDateArabic(selectedIso)}
                    <span class="badge badge--green">${slots.length} جلسات</span>
                  </h2>
                  <p>يمكنك تعديل أي موعد غير محجوز أو حذفه، وستظهر الخيارات لتطبيق ذلك على هذا التاريخ فقط أو كل أسبوع.</p>
                </div>
                <div class="day-panel-actions">
                  <button class="btn btn--sm btn--accent" id="schedule-add-slot-panel">
                    ${Icons.plus} إضافة جلسة
                  </button>
                </div>
              </div>

              <div class="slot-list">
                ${slotListHtml}
              </div>

              <div class="legend-row">
                <span class="legend-item"><span class="legend-dot"></span> متاح للحجز</span>
                <span class="legend-item"><span class="legend-dot legend-dot--booked"></span> محجوز من مريض</span>
                <span class="legend-item"><span class="legend-dot legend-dot--past"></span> انتهى وقته</span>
              </div>
            </div>
          </div>

          <!-- Schedule Sidebar Guide -->
          <div class="rail-panel">
            <div style="padding: 18px;">
              <h3 style="font-size: 13.5px; font-weight: 800; color: var(--navy-900); display: flex; align-items: center; gap: 6px;">
                ${Icons.shield} ميزات الجدولة الذكية
              </h3>
              <div style="margin-top: 10px; font-size: 11px; color: var(--muted); line-height: 1.8;">
                <p>• <strong>الحفاظ على الحجوزات السابقة:</strong> تعديل الجدول الأسبوعي لا يؤثر مطلقاً على أي حجوزات تمت بالفعل.</p>
                <p style="margin-top: 8px;">• <strong>منع التداخل:</strong> يتحقق النظام تلقائياً من عدم وجود تضارب بين أوقات الجلسات في نفس اليوم.</p>
                <p style="margin-top: 8px;">• <strong>خيارات التعديل:</strong> عند تعديل أو حذف أي جلسة، يمكنك اختيار تطبيق التغيير على هذا التاريخ فقط أو على كل الأسابيع القادمة.</p>
              </div>
            </div>
          </div>
        </div>
      `;
    },

    bindDoctorScheduleEvents() {
      // Select day in week strip
      document.querySelectorAll('.week-day').forEach(btn => {
        btn.addEventListener('click', () => {
          const iso = btn.getAttribute('data-iso');
          App._scheduleSelectedDate = iso;
          App.refreshCurrentView();
        });
      });

      const openAdd = () => {
        const iso = App._scheduleSelectedDate || DateHelper.todayISO();
        Modals.openAddSlotModal(iso);
      };

      document.getElementById('schedule-add-slot-main')?.addEventListener('click', openAdd);
      document.getElementById('schedule-add-slot-panel')?.addEventListener('click', openAdd);
      document.getElementById('schedule-empty-add-btn')?.addEventListener('click', openAdd);

      // Edit slot buttons
      document.querySelectorAll('.edit-slot-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const slotId = btn.getAttribute('data-id');
          const start = btn.getAttribute('data-start');
          const end = btn.getAttribute('data-end');
          const iso = App._scheduleSelectedDate || DateHelper.todayISO();
          Modals.openEditSlotModal({ id: slotId, startTime: start, endTime: end }, iso);
        });
      });

      // Delete slot buttons
      document.querySelectorAll('.delete-slot-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const slotId = btn.getAttribute('data-id');
          const start = btn.getAttribute('data-start');
          const end = btn.getAttribute('data-end');
          const iso = App._scheduleSelectedDate || DateHelper.todayISO();
          Modals.openDeleteSlotModal({ id: slotId, startTime: start, endTime: end }, iso);
        });
      });

      // View booking buttons
      document.querySelectorAll('.view-booking-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const bookingId = btn.getAttribute('data-id');
          Modals.openBookingDetailsModal(bookingId);
        });
      });
    },

    /* ---------------- TODAY'S APPOINTMENTS ---------------- */
    DoctorToday() {
      const todayISO = DateHelper.todayISO();
      const todayArabic = DateHelper.formatDateArabic(todayISO);
      const bookings = ClinicEngine.getBookings().filter(b => b.date === todayISO);

      let rowsHtml = '';
      if (bookings.length === 0) {
        rowsHtml = `
          <tr>
            <td colspan="7">
              <div class="empty-state">
                <div class="empty-state__art">${Icons.clock}</div>
                <h3>لا توجد أي حجوزات مسجلة اليوم</h3>
                <p>يمكن للمرضى حجز المواعيد المتاحة عبر بوابة حجز المرضى.</p>
              </div>
            </td>
          </tr>
        `;
      } else {
        rowsHtml = bookings.map(b => `
          <tr>
            <td>
              <div class="table-patient">
                <div class="patient-avatar">${b.patientName.charAt(0) || 'م'}</div>
                <div>
                  <strong>${b.patientName}</strong>
                  <span>${Icons.phone} ${b.patientPhone}</span>
                </div>
              </div>
            </td>
            <td>
              <strong>${DateHelper.formatTimeArabic(b.startTime)} - ${DateHelper.formatTimeArabic(b.endTime)}</strong>
            </td>
            <td><code class="table-id">${b.id}</code></td>
            <td><strong class="table-amount">${b.amount} ${b.currency}</strong></td>
            <td>
              <span class="badge badge--green">${b.paymentStatus === 'paid' ? 'مدفوع' : 'معلق'}</span>
            </td>
            <td>
              <span class="badge ${b.bookingStatus === 'confirmed' ? 'badge--navy' : b.bookingStatus === 'completed' ? 'badge--blue' : 'badge--red'}">
                ${b.bookingStatus === 'confirmed' ? 'مؤكد' : b.bookingStatus === 'completed' ? 'تم الحضور' : 'ملغي'}
              </span>
            </td>
            <td>
              <div class="table-actions">
                <button class="btn btn--sm btn--outline view-booking-btn" data-id="${b.id}" title="عرض تفاصيل الحجز">${Icons.user} تفاصيل</button>
                ${b.bookingStatus === 'confirmed' ? `
                  <button class="btn btn--sm btn--accent mark-completed-btn" data-id="${b.id}" title="تأكيد حضور المريض">${Icons.check}</button>
                ` : ''}
              </div>
            </td>
          </tr>
        `).join('');
      }

      return `
        <div class="page-heading">
          <div class="page-heading__copy">
            <div class="page-kicker"><span class="dot">•</span> قائمة كشف اليوم</div>
            <h1>حجوزات اليوم (${todayArabic})</h1>
            <p>استعراض جميع المواعيد المحجوزة اليوم، مع بيانات المرضى وحالة الدفع وإمكانية تعديل الحالة فورياً.</p>
          </div>
        </div>

        <div class="table-card">
          <div class="table-toolbar">
            <div class="table-toolbar__title">
              ${Icons.clock} إجمالي حجوزات اليوم: ${bookings.length} مريض
            </div>
          </div>
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>اسم المريض والهاتف</th>
                  <th>توقيت الجلسة</th>
                  <th>رقم الحجز</th>
                  <th>سعر الكشف</th>
                  <th>حالة الدفع</th>
                  <th>حالة الحجز</th>
                  <th>إجراءات</th>
                </tr>
              </thead>
              <tbody>
                ${rowsHtml}
              </tbody>
            </table>
          </div>
        </div>
      `;
    },

    bindDoctorTodayEvents() {
      document.querySelectorAll('.view-booking-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const bookingId = btn.getAttribute('data-id');
          Modals.openBookingDetailsModal(bookingId);
        });
      });

      document.querySelectorAll('.mark-completed-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const bookingId = btn.getAttribute('data-id');
          ClinicEngine.updateBookingStatus(bookingId, 'completed');
          showToast('تم التحديث', 'تم تسجيل حضور المريض وإكمال الجلسة بنجاح.', 'success');
          App.refreshCurrentView();
        });
      });
    },

    /* ---------------- ALL BOOKINGS VIEW ---------------- */
    DoctorAllBookings() {
      const allBookings = ClinicEngine.getBookings();

      const searchQuery = (App._allBookingsSearch || '').trim().toLowerCase();
      const statusFilter = App._allBookingsStatus || 'all';
      const paymentFilter = App._allBookingsPayment || 'all';
      const dateFilter = App._allBookingsDate || '';

      const filtered = allBookings.filter(b => {
        if (searchQuery) {
          const nameMatch = (b.patientName || '').toLowerCase().includes(searchQuery);
          const phoneMatch = (b.patientPhone || '').includes(searchQuery);
          const idMatch = (b.id || '').toLowerCase().includes(searchQuery);
          if (!nameMatch && !phoneMatch && !idMatch) return false;
        }
        if (statusFilter !== 'all' && b.bookingStatus !== statusFilter) return false;
        if (paymentFilter !== 'all' && b.paymentStatus !== paymentFilter) return false;
        if (dateFilter && b.date !== dateFilter) return false;
        return true;
      });

      let rowsHtml = '';
      if (filtered.length === 0) {
        rowsHtml = `
          <tr>
            <td colspan="8">
              <div class="empty-state">
                <div class="empty-state__art">${Icons.search}</div>
                <h3>لم يتم العثور على أي حجوزات مطابقة</h3>
                <p>جرب تغيير معايير البحث أو مسح الفلاتر المطبقة لعرض النتائج.</p>
              </div>
            </td>
          </tr>
        `;
      } else {
        rowsHtml = filtered.map(b => `
          <tr>
            <td>
              <div class="table-patient">
                <div class="patient-avatar">${b.patientName.charAt(0) || 'م'}</div>
                <div>
                  <strong>${b.patientName}</strong>
                  <span>${Icons.phone} ${b.patientPhone}</span>
                </div>
              </div>
            </td>
            <td>
              <div class="table-date">
                <span>${DateHelper.formatDateArabic(b.date, false)}</span>
              </div>
            </td>
            <td><strong>${DateHelper.formatTimeArabic(b.startTime)}</strong></td>
            <td><code class="table-id">${b.id}</code></td>
            <td><strong class="table-amount">${b.amount} ${b.currency}</strong></td>
            <td>
              <span class="badge ${b.paymentStatus === 'paid' ? 'badge--green' : 'badge--amber'}">
                ${b.paymentStatus === 'paid' ? 'مدفوع' : 'معلق'}
              </span>
            </td>
            <td>
              <span class="badge ${b.bookingStatus === 'confirmed' ? 'badge--navy' : b.bookingStatus === 'completed' ? 'badge--blue' : 'badge--red'}">
                ${b.bookingStatus === 'confirmed' ? 'مؤكد' : b.bookingStatus === 'completed' ? 'مكتمل' : 'ملغي'}
              </span>
            </td>
            <td>
              <div class="table-actions">
                <button class="btn btn--sm btn--outline view-booking-btn" data-id="${b.id}" title="عرض تفاصيل الحجز">${Icons.user} تفاصيل</button>
              </div>
            </td>
          </tr>
        `).join('');
      }

      return `
        <div class="page-heading">
          <div class="page-heading__copy">
            <div class="page-kicker"><span class="dot">•</span> السجل الكامل</div>
            <h1>جميع الحجوزات المسجلة</h1>
            <p>أرشيف متكامل لجميع حجوزات العيادة مع إمكانية البحث بالاسم أو رقم الهاتف والفلترة بالتواريخ والحالات.</p>
          </div>
        </div>

        <div class="filter-card">
          <div class="filter-row">
            <div class="search-box">
              ${Icons.search}
              <input type="text" id="bookings-search-input" placeholder="ابحث باسم المريض أو رقم الهاتف أو كود الحجز..." value="${App._allBookingsSearch || ''}">
            </div>

            <select id="bookings-status-filter" class="filter-select">
              <option value="all" ${statusFilter === 'all' ? 'selected' : ''}>جميع الحالات</option>
              <option value="confirmed" ${statusFilter === 'confirmed' ? 'selected' : ''}>مؤكد</option>
              <option value="completed" ${statusFilter === 'completed' ? 'selected' : ''}>مكتمل</option>
              <option value="cancelled" ${statusFilter === 'cancelled' ? 'selected' : ''}>ملغي</option>
            </select>

            <select id="bookings-payment-filter" class="filter-select">
              <option value="all" ${paymentFilter === 'all' ? 'selected' : ''}>حالة الدفع: الكل</option>
              <option value="paid" ${paymentFilter === 'paid' ? 'selected' : ''}>مدفوع</option>
              <option value="pending" ${paymentFilter === 'pending' ? 'selected' : ''}>معلق</option>
            </select>

            <input type="date" id="bookings-date-filter" class="input filter-date" value="${dateFilter}">

            <button class="filter-clear" id="bookings-clear-filters-btn">
              ${Icons.x} مسح الفلاتر
            </button>
          </div>
        </div>

        <div class="results-head">
          <span>نتائج البحث: <strong>${filtered.length}</strong> من إجمالي ${allBookings.length} حجز</span>
        </div>

        <div class="table-card">
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>اسم المريض ورقم الهاتف</th>
                  <th>تاريخ الحجز</th>
                  <th>التوقيت</th>
                  <th>رقم الحجز</th>
                  <th>المبلغ</th>
                  <th>حالة الدفع</th>
                  <th>حالة الحجز</th>
                  <th>إجراءات</th>
                </tr>
              </thead>
              <tbody>
                ${rowsHtml}
              </tbody>
            </table>
          </div>
        </div>
      `;
    },

    bindDoctorAllBookingsEvents() {
      const searchInput = document.getElementById('bookings-search-input');
      const statusSelect = document.getElementById('bookings-status-filter');
      const paymentSelect = document.getElementById('bookings-payment-filter');
      const dateInput = document.getElementById('bookings-date-filter');
      const clearBtn = document.getElementById('bookings-clear-filters-btn');

      const applyFilters = () => {
        App._allBookingsSearch = searchInput?.value || '';
        App._allBookingsStatus = statusSelect?.value || 'all';
        App._allBookingsPayment = paymentSelect?.value || 'all';
        App._allBookingsDate = dateInput?.value || '';
        App.refreshCurrentView();
      };

      searchInput?.addEventListener('input', () => applyFilters());
      statusSelect?.addEventListener('change', () => applyFilters());
      paymentSelect?.addEventListener('change', () => applyFilters());
      dateInput?.addEventListener('change', () => applyFilters());

      clearBtn?.addEventListener('click', () => {
        App._allBookingsSearch = '';
        App._allBookingsStatus = 'all';
        App._allBookingsPayment = 'all';
        App._allBookingsDate = '';
        App.refreshCurrentView();
      });

      document.querySelectorAll('.view-booking-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const bookingId = btn.getAttribute('data-id');
          Modals.openBookingDetailsModal(bookingId);
        });
      });
    },

    /* ---------------- DOCTOR SETTINGS VIEW ---------------- */
    DoctorSettings() {
      const settings = ClinicEngine.getSettings();
      const auth = ClinicEngine.getAuth();

      return `
        <div class="page-heading">
          <div class="page-heading__copy">
            <div class="page-kicker"><span class="dot">•</span> التخصيص والأمان</div>
            <h1>إعدادات العيادة والحساب</h1>
            <p>تعديل بيانات العيادة، سعر الكشف، تفضيلات الجدولة الأسبوعية، وبيانات تسجيل الدخول.</p>
          </div>
        </div>

        <div class="settings-layout">
          <div class="settings-stack">
            <!-- Clinic Info Card -->
            <div class="settings-card">
              <div class="settings-card__head">
                <div class="settings-card__icon">${Icons.stethoscope}</div>
                <div>
                  <h2>بيانات العيادة والطبيب</h2>
                  <p>تظهر هذه البيانات للمرضى في بوابة الحجز وعلى إيصالات الدفع</p>
                </div>
              </div>
              <form id="clinic-settings-form">
                <div class="settings-card__body">
                  <div class="modal-form-grid">
                    <div class="field span-2">
                      <label for="set-clinic-name">اسم العيادة</label>
                      <input type="text" id="set-clinic-name" class="input" value="${settings.clinicName || 'عيادة الشفاء التخصصية'}" required>
                    </div>
                    <div class="field">
                      <label for="set-doctor-name">اسم الطبيب</label>
                      <input type="text" id="set-doctor-name" class="input" value="${settings.doctorName || 'د. أحمد محمد'}" required>
                    </div>
                    <div class="field">
                      <label for="set-specialty">التخصص الطبي</label>
                      <input type="text" id="set-specialty" class="input" value="${settings.specialty || 'طب الباطنة والجهاز الهضمي'}" required>
                    </div>
                    <div class="field">
                      <label for="set-price">سعر الكشف (بالجنيه المصري)</label>
                      <input type="number" id="set-price" class="input" value="${settings.price || 100}" min="1" step="5" required>
                    </div>
                    <div class="field">
                      <label for="set-currency">العملة</label>
                      <input type="text" id="set-currency" class="input" value="${settings.currency || 'ج.م'}" readonly style="background: var(--surface);">
                    </div>
                  </div>
                </div>
                <div class="settings-card__foot">
                  <p>${Icons.info} يتم تطبيق التغييرات فوراً على واجهة حجز المرضى.</p>
                  <button type="submit" class="btn btn--accent btn--sm">${Icons.check} حفظ بيانات العيادة</button>
                </div>
              </form>
            </div>

            <!-- Scheduling Preferences Card -->
            <div class="settings-card">
              <div class="settings-card__head">
                <div class="settings-card__icon">${Icons.calendar}</div>
                <div>
                  <h2>تفضيلات الجدولة الأسبوعية</h2>
                  <p>تحديد أول أيام الأسبوع المعروض للمرضى والمدة الزمنية الافتراضية للجلسات</p>
                </div>
              </div>
              <form id="schedule-settings-form">
                <div class="settings-card__body">
                  <div class="modal-form-grid">
                    <div class="field">
                      <label for="set-first-day">أول أيام الأسبوع</label>
                      <select id="set-first-day" class="select">
                        <option value="sat" ${(settings.firstDayOfWeek || 'sat') === 'sat' ? 'selected' : ''}>السبت (المعتمد في مصر)</option>
                        <option value="sun" ${settings.firstDayOfWeek === 'sun' ? 'selected' : ''}>الأحد</option>
                        <option value="mon" ${settings.firstDayOfWeek === 'mon' ? 'selected' : ''}>الإثنين</option>
                      </select>
                    </div>
                    <div class="field">
                      <label for="set-duration">المدة الافتراضية للجلسة (دقيقة)</label>
                      <select id="set-duration" class="select">
                        <option value="15" ${settings.defaultDuration === 15 ? 'selected' : ''}>15 دقيقة</option>
                        <option value="20" ${settings.defaultDuration === 20 ? 'selected' : ''}>20 دقيقة</option>
                        <option value="30" ${(settings.defaultDuration || 30) === 30 ? 'selected' : ''}>30 دقيقة (افتراضي)</option>
                        <option value="45" ${settings.defaultDuration === 45 ? 'selected' : ''}>45 دقيقة</option>
                        <option value="60" ${settings.defaultDuration === 60 ? 'selected' : ''}>60 دقيقة</option>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="settings-card__foot">
                  <p>تغيير أول أيام الأسبوع يعيد حساب الأسبوع الحالي للمرضى تلقائياً.</p>
                  <button type="submit" class="btn btn--accent btn--sm">${Icons.check} حفظ تفضيلات الجدولة</button>
                </div>
              </form>
            </div>

            <!-- Account Credentials Card -->
            <div class="settings-card">
              <div class="settings-card__head">
                <div class="settings-card__icon">${Icons.lock}</div>
                <div>
                  <h2>إعدادات أمان الحساب وتغيير كلمة المرور</h2>
                  <p>تعديل اسم المستخدم وكلمة المرور الخاصة بلوحة تحكم الطبيب</p>
                </div>
              </div>
              <form id="account-credentials-form">
                <div class="settings-card__body">
                  <div class="modal-form-grid">
                    <div class="field span-2">
                      <label for="acc-current-pass">كلمة المرور الحالية (مطلوبة للتحقق)</label>
                      <input type="password" id="acc-current-pass" class="input" placeholder="أدخل كلمة المرور الحالية" required autocomplete="current-password">
                    </div>
                    <div class="field">
                      <label for="acc-new-username">اسم المستخدم الجديد</label>
                      <input type="text" id="acc-new-username" class="input" value="${auth.username || 'doctor'}" required autocomplete="username">
                    </div>
                    <div class="field">
                      <label for="acc-new-pass">كلمة المرور الجديدة</label>
                      <input type="password" id="acc-new-pass" class="input" placeholder="6 خانات على الأقل" required autocomplete="new-password">
                    </div>
                    <div class="field span-2">
                      <label for="acc-confirm-pass">تأكيد كلمة المرور الجديدة</label>
                      <input type="password" id="acc-confirm-pass" class="input" placeholder="أعد إدخال كلمة المرور الجديدة" required autocomplete="new-password">
                    </div>
                  </div>
                </div>
                <div class="settings-card__foot">
                  <p>${Icons.shield} يرجى حفظ بياناتك الجديدة جيداً للتمكن من الدخول لاحقاً.</p>
                  <button type="submit" class="btn btn--accent btn--sm">${Icons.check} تحديث بيانات الدخول</button>
                </div>
              </form>
            </div>
          </div>

          <!-- Settings Sidebar Actions -->
          <div class="settings-side">
            <div class="profile-card">
              <div class="profile-card__head">
                <div class="doctor-avatar">د</div>
                <div>
                  <strong>${settings.doctorName || 'د. أحمد محمد'}</strong>
                  <span>طبيب العيادة المعتمد</span>
                </div>
              </div>
              <div class="profile-card__info">
                <div class="profile-card__row">
                  <span>اسم المستخدم:</span>
                  <strong>${auth.username || 'doctor'}</strong>
                </div>
                <div class="profile-card__row">
                  <span>التخصص:</span>
                  <strong>${settings.specialty || 'طب الباطنة'}</strong>
                </div>
                <div class="profile-card__row">
                  <span>سعر الكشف:</span>
                  <strong>${settings.price || 100} ${settings.currency || 'ج.م'}</strong>
                </div>
              </div>
            </div>

            <!-- Reset Demo Data Card -->
            <div class="danger-card">
              <h3>${Icons.alert} إعادة ضبط البيانات التجريبية</h3>
              <p>استعادة البيانات الأولية للنموذج التجريبي وإعادة الجداول والمواعيد الافتراضية وحذف أي حجوزات تمت إضافتها لاحقاً.</p>
              <button type="button" class="btn btn--danger-soft" id="settings-reset-demo-btn">
                ${Icons.refresh} إعادة ضبط النظام إلى بيانات العرض
              </button>
            </div>
          </div>
        </div>
      `;
    },

    bindDoctorSettingsEvents() {
      // Clinic Info Form
      document.getElementById('clinic-settings-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const clinicName = document.getElementById('set-clinic-name').value;
        const doctorName = document.getElementById('set-doctor-name').value;
        const specialty = document.getElementById('set-specialty').value;
        const price = Number(document.getElementById('set-price').value) || 100;

        ClinicEngine.updateSettings({ clinicName, doctorName, specialty, price });
        showToast('تم الحفظ', 'تم تحديث بيانات العيادة وسعر الكشف بنجاح.', 'success');
        App.refreshCurrentView();
      });

      // Scheduling Form
      document.getElementById('schedule-settings-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const firstDayOfWeek = document.getElementById('set-first-day').value;
        const defaultDuration = Number(document.getElementById('set-duration').value) || 30;

        ClinicEngine.updateSettings({ firstDayOfWeek, defaultDuration });
        showToast('تم الحفظ', 'تم تحديث تفضيلات الجدولة الأسبوعية بنجاح.', 'success');
        App.refreshCurrentView();
      });

      // Account Credentials Form
      document.getElementById('account-credentials-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const currentPass = document.getElementById('acc-current-pass').value;
        const newUsername = document.getElementById('acc-new-username').value;
        const newPass = document.getElementById('acc-new-pass').value;
        const confirmPass = document.getElementById('acc-confirm-pass').value;

        if (newPass !== confirmPass) {
          showToast('خطأ في التأكيد', 'كلمة المرور الجديدة غير متطابقة مع حقل التأكيد.', 'error');
          return;
        }

        const res = ClinicEngine.updateCredentials(currentPass, newUsername, newPass);
        if (res.success) {
          showToast('تم التحديث بنجاح', 'تم تغيير بيانات تسجيل الدخول. يمكنك الآن استخدام بياناتك الجديدة.', 'success');
          App.refreshCurrentView();
        } else {
          showToast('تعذر التحديث', res.error, 'error');
        }
      });

      // Reset Demo Data Button
      document.getElementById('settings-reset-demo-btn')?.addEventListener('click', () => {
        Modals.openResetDataConfirm();
      });
    },

    /* ---------------- PATIENT BOOKING INTERFACE ---------------- */
    PatientPortal() {
      const state = App.patientBookingState;
      const settings = ClinicEngine.getSettings();
      const firstDayKey = settings.firstDayOfWeek || 'sat';
      const weekDates = DateHelper.getCurrentWeekDates(firstDayKey);

      // Determine current booking step (1: Select slot, 2: Info, 3: Payment, 4: Confirmation)
      let step = 1;
      if (state.bookingResult) {
        step = 4;
      } else if (state.patientName && state.patientPhone && state.selectedSlot) {
        step = 3;
      } else if (state.selectedSlot) {
        step = 2;
      }

      // Step 1 selected date
      if (!state.selectedDate) {
        const todayIso = DateHelper.todayISO();
        state.selectedDate = weekDates.some(w => w.iso === todayIso) ? todayIso : weekDates[0].iso;
      }

      let stepContentHtml = '';
      if (step === 1) stepContentHtml = Views.PatientStep1(weekDates);
      else if (step === 2) stepContentHtml = Views.PatientStep2();
      else if (step === 3) stepContentHtml = Views.PatientStep3();
      else if (step === 4) stepContentHtml = Views.PatientStep4();

      return `
        <div class="patient-shell">
          <!-- Public Header -->
          <header class="public-header">
            <div class="public-header__inner">
              <div class="brand">
                <div class="brand-mark">
                  <svg viewBox="0 0 64 64" fill="none"><path d="M12 34h11l6-17 9 31 6-22 4 8h9" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="brand-word">
                  <strong>${settings.clinicName || 'عيادة الشفاء'}</strong>
                  <span>حجز موعد كشف طبي</span>
                </div>
              </div>
              <div class="public-header__actions">
                <button class="btn btn--outline btn--sm" id="patient-to-doctor-btn">
                  ${Icons.stethoscope} دخول الطبيب
                </button>
              </div>
            </div>
          </header>

          <main class="patient-main ${step === 4 ? 'patient-main--wide' : ''}">
            <!-- Progress indicator -->
            <div class="booking-progress-wrap">
              <div class="booking-progress">
                <div class="progress-step ${step > 1 ? 'is-complete' : step === 1 ? 'is-active' : ''}">
                  <div class="progress-step__circle">${step > 1 ? Icons.check : '1'}</div>
                  <span class="progress-step__label">اختيار الموعد</span>
                </div>
                <div class="progress-step ${step > 2 ? 'is-complete' : step === 2 ? 'is-active' : ''}">
                  <div class="progress-step__circle">${step > 2 ? Icons.check : '2'}</div>
                  <span class="progress-step__label">بيانات المريض</span>
                </div>
                <div class="progress-step ${step > 3 ? 'is-complete' : step === 3 ? 'is-active' : ''}">
                  <div class="progress-step__circle">${step > 3 ? Icons.check : '3'}</div>
                  <span class="progress-step__label">الدفع الإلكتروني</span>
                </div>
                <div class="progress-step ${step === 4 ? 'is-complete is-active' : ''}">
                  <div class="progress-step__circle">${step === 4 ? Icons.check : '4'}</div>
                  <span class="progress-step__label">تأكيد الحجز</span>
                </div>
              </div>
            </div>

            ${stepContentHtml}
          </main>

          <footer class="public-footer">
            <div class="public-footer__inner">
              <span>جميع الحقوق محفوظة © ${settings.clinicName || 'عيادة الشفاء'} • نظام نبض الطبي</span>
              <span>${Icons.shield} حجز آمن ومحمي بالكامل</span>
            </div>
          </footer>
        </div>
      `;
    },

    /* Step 1: Select slot */
    PatientStep1(weekDates) {
      const state = App.patientBookingState;
      const settings = ClinicEngine.getSettings();
      const selectedIso = state.selectedDate;
      const slots = ClinicEngine.getScheduleForDate(selectedIso);

      const datesRibbonHtml = weekDates.map(w => {
        const isSelected = w.iso === selectedIso;
        const daySlots = ClinicEngine.getScheduleForDate(w.iso);
        const availableCount = daySlots.filter(s => s.status === 'available').length;
        const isPastDate = w.iso < DateHelper.todayISO();

        return `
          <button class="booking-date ${isSelected ? 'is-selected' : ''} ${w.isToday ? 'is-today' : ''}" data-iso="${w.iso}" ${isPastDate ? 'disabled title="تاريخ سابق لا يمكن الحجز فيه"' : ''}>
            ${w.isToday ? '<span class="booking-date__today-dot" title="اليوم"></span>' : ''}
            <span class="booking-date__name">${w.dayName}</span>
            <span class="booking-date__num">${w.dayNum}</span>
            <span class="booking-date__slots ${availableCount === 0 ? 'no-slots' : ''}">
              ${isPastDate ? 'منتهي' : availableCount > 0 ? `${availableCount} متاح` : 'مكتمل'}
            </span>
          </button>
        `;
      }).join('');

      let sessionCardsHtml = '';
      if (slots.length === 0) {
        sessionCardsHtml = `
          <div class="session-empty" style="grid-column: 1 / -1;">
            <div class="icon">${Icons.calendar}</div>
            <h3>لا توجد مواعيد متاحة في هذا اليوم</h3>
            <p>يرجى اختيار يوم آخر من أيام الأسبوع الحالي المتاحة أعلاه.</p>
          </div>
        `;
      } else {
        sessionCardsHtml = slots.map(slot => {
          const isAvailable = slot.status === 'available';
          const isBooked = slot.status === 'booked';
          const isPast = slot.status === 'past';

          let statusBadge = '<span class="badge badge--green">متاح للحجز</span>';
          let actionText = `احجز الآن ${Icons.arrowLeft}`;

          if (isBooked) {
            statusBadge = '<span class="badge badge--navy">محجوز</span>';
            actionText = 'غير متاح';
          } else if (isPast) {
            statusBadge = '<span class="badge badge--gray">انتهى وقته</span>';
            actionText = 'انتهى';
          }

          return `
            <button class="session-option select-slot-btn" data-id="${slot.id}" data-start="${slot.startTime}" data-end="${slot.endTime}" ${!isAvailable ? 'disabled' : ''}>
              <div class="session-option__time">
                <strong>${slot.formattedStart}</strong>
                <span>إلى ${slot.formattedEnd}</span>
              </div>
              <div class="session-option__divider"></div>
              <div class="session-option__main">
                <strong>جلسة كشف عيادة</strong>
                <span>مدة الكشف: ${settings.defaultDuration || 30} دقيقة</span>
              </div>
              <div class="session-option__status">
                ${statusBadge}
                <span class="session-option__go">${actionText}</span>
              </div>
            </button>
          `;
        }).join('');
      }

      return `
        <div class="patient-page-head">
          <div>
            <div class="patient-kicker">${Icons.stethoscope} الحجز الإلكتروني المباشر</div>
            <h1>اختر موعد الكشف الطبي</h1>
            <p>تفضل باختيار اليوم والوقت المناسب لك خلال الأسبوع الجاري لحجز كشفك الطبي.</p>
          </div>
          <div class="week-badge">
            <span class="icon">${Icons.calendar}</span>
            <div>
              <span>الأسبوع المتاح للحجز</span>
              <strong>${DateHelper.formatDateArabic(weekDates[0].iso, false)} - ${DateHelper.formatDateArabic(weekDates[6].iso, false)}</strong>
            </div>
          </div>
        </div>

        <div class="patient-layout">
          <div class="booking-stage">
            <div class="booking-stage-card">
              <div class="booking-stage-card__head">
                <h2>
                  <span class="step-badge">1</span> اختر اليوم المناسب
                </h2>
                <p>الحجز متاح خلال أيام الأسبوع الحالي فقط وفقاً لجدول العيادة</p>
              </div>
              <div class="booking-stage-card__body">
                <div class="date-ribbon-label">
                  <strong>أيام الأسبوع الحالي:</strong>
                  <span>${Icons.clock} الأوقات بتوقيت القاهرة</span>
                </div>
                <div class="booking-dates">
                  ${datesRibbonHtml}
                </div>

                <div class="session-section-head">
                  <h3>${Icons.clock} المواعيد المتاحة ليوم ${DateHelper.formatDateArabic(selectedIso)}</h3>
                  <span>اختر التوقيت للمتابعة</span>
                </div>

                <div class="session-options">
                  ${sessionCardsHtml}
                </div>

                <div class="booking-note">
                  ${Icons.info}
                  <div>
                    <strong>تنويه:</strong> يتم تأكيد الحجز مباشرة بعد إتمام محاكاة الدفع عبر فودافون كاش في الخطوة التالية.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Doctor & Clinic Summary Sidebar -->
          <aside class="clinic-summary">
            <div class="clinic-summary__banner">
              <div class="clinic-summary__eyebrow">
                <span class="dot">•</span> الطبيب المعالج
              </div>
              <div class="clinic-doctor">
                <div class="doctor-avatar">د</div>
                <div>
                  <strong>${settings.doctorName || 'د. أحمد محمد'}</strong>
                  <span>${settings.specialty || 'طب الباطنة والجهاز الهضمي'}</span>
                </div>
              </div>
            </div>

            <div class="clinic-summary__body">
              <div class="clinic-info-list">
                <div class="clinic-info-row">
                  <span>${Icons.home} العيادة</span>
                  <strong>${settings.clinicName || 'عيادة الشفاء'}</strong>
                </div>
                <div class="clinic-info-row">
                  <span>${Icons.phone} هاتف العيادة</span>
                  <strong style="direction: ltr;">${settings.phone || '01001234567'}</strong>
                </div>
                <div class="clinic-info-row">
                  <span>${Icons.wallet} وسيلة الدفع</span>
                  <strong>فودافون كاش</strong>
                </div>
              </div>

              <div class="clinic-price">
                <div class="clinic-price__label">
                  <span>قيمة الكشف الطبي</span>
                  <span class="badge badge--green">شامل الضريبة</span>
                </div>
                <div class="clinic-price__value">
                  <strong>${settings.price || 100}</strong>
                  <span>${settings.currency || 'ج.م'}</span>
                </div>
              </div>

              <div class="clinic-features">
                <div class="clinic-feature">
                  <span class="feature-check">${Icons.check}</span>
                  <span>حجز إلكتروني فوري بدون إنشاء حساب</span>
                </div>
                <div class="clinic-feature">
                  <span class="feature-check">${Icons.check}</span>
                  <span>إيصال حجز وتأكيد رسمي قابل للطباعة</span>
                </div>
                <div class="clinic-feature">
                  <span class="feature-check">${Icons.check}</span>
                  <span>تنظيم كامل للدور بدون فترات انتظار طويلة</span>
                </div>
              </div>
            </div>
          </aside>
        </div>
      `;
    },

    /* Step 2: Patient Info */
    PatientStep2() {
      const state = App.patientBookingState;
      const settings = ClinicEngine.getSettings();
      const slot = state.selectedSlot;
      const dateIso = state.selectedDate;

      return `
        <div class="checkout-layout">
          <div class="checkout-main">
            <div class="card checkout-form">
              <div class="checkout-heading">
                <div>
                  <h2>بيانات المريض الأساسية</h2>
                  <p>لا يلزم إنشاء حساب أو كلمة مرور، فقط أدخل اسمك ورقم هاتفك المحمول للتواصل.</p>
                </div>
                <span class="badge badge--green">الخطوة 2 من 3</span>
              </div>

              <form id="patient-info-form">
                <div class="checkout-form-grid">
                  <div class="field">
                    <label for="patient-fullname">الاسم بالكامل (ثلاثي أو رباعي) *</label>
                    <input type="text" id="patient-fullname" class="input" placeholder="مثال: محمود إبراهيم الشناوي" required value="${state.patientName || ''}">
                    <span class="field-error" id="name-error" style="display: none; color: var(--red-600); font-size: 10px; margin-top: 3px;">يرجى إدخال اسم صحيح مكون من 3 أحرف على الأقل.</span>
                  </div>

                  <div class="field">
                    <label for="patient-phone">رقم الهاتف المحمول (مصر) *</label>
                    <div style="position: relative; display: flex; align-items: center;">
                      <input type="tel" id="patient-phone" class="input" placeholder="01012345678" required value="${state.patientPhone || ''}" style="direction: ltr; text-align: right; width: 100%;">
                    </div>
                    <span style="display: block; font-size: 10px; color: var(--muted); margin-top: 3px;">رقم هاتف مصري مكون من 11 رقماً يبدأ بـ 010 أو 011 أو 012 أو 015</span>
                    <span class="field-error" id="phone-error" style="display: none; color: var(--red-600); font-size: 10px; margin-top: 3px;">يرجى إدخال رقم هاتف محمول مصري صحيح (11 رقماً).</span>
                  </div>
                </div>

                <div class="btn-row">
                  <button type="button" class="btn btn--outline" id="back-to-step1-btn">
                    ${Icons.arrowRight} تغيير الموعد
                  </button>
                  <button type="submit" class="btn btn--accent">
                    المتابعة إلى الدفع الإلكتروني ${Icons.arrowLeft}
                  </button>
                </div>

                <div class="form-secure-note" style="margin-top: 15px;">
                  ${Icons.shield} بياناتك مشفرة ومحفوظة بسرية تامة ولا تتم مشاركتها خارج العيادة.
                </div>
              </form>
            </div>
          </div>

          <!-- Order Summary Sidebar -->
          <aside class="order-summary">
            <div class="order-summary__head">
              <h2>${Icons.calendar} ملخص الحجز الطبي</h2>
            </div>
            <div class="order-summary__body">
              <div class="selected-appointment">
                <div class="selected-date-box">
                  <strong>${DateHelper.fromISODate(dateIso).getDate()}</strong>
                  <span>${MONTH_NAMES[DateHelper.fromISODate(dateIso).getMonth()]}</span>
                </div>
                <div class="selected-appointment__main">
                  <strong>${DateHelper.formatDateArabic(dateIso, false)}</strong>
                  <span>${Icons.clock} ${DateHelper.formatTimeArabic(slot.startTime)} - ${DateHelper.formatTimeArabic(slot.endTime)}</span>
                </div>
              </div>

              <div class="summary-lines">
                <div class="summary-line">
                  <span>${Icons.stethoscope} الطبيب المعالج</span>
                  <strong>${settings.doctorName || 'د. أحمد محمد'}</strong>
                </div>
                <div class="summary-line">
                  <span>${Icons.home} العيادة</span>
                  <strong>${settings.clinicName || 'عيادة الشفاء'}</strong>
                </div>
                <div class="summary-line">
                  <span>${Icons.clock} التخصص</span>
                  <strong>${settings.specialty || 'طب الباطنة'}</strong>
                </div>
              </div>

              <div class="summary-total">
                <span>المبلغ المطلوب سداده</span>
                <strong>${settings.price || 100} <small>${settings.currency || 'ج.م'}</small></strong>
              </div>

              <div class="summary-assurance">
                ${Icons.check} وسيلة الدفع المقبولة في الخطوة القادمة هي محفظة فودافون كاش.
              </div>
            </div>
          </aside>
        </div>
      `;
    },

    /* Step 3: Vodafone Cash Payment Gateway Simulation */
    PatientStep3() {
      const state = App.patientBookingState;
      const settings = ClinicEngine.getSettings();
      const slot = state.selectedSlot;
      const dateIso = state.selectedDate;
      const price = settings.price || 100;

      // Default wallet phone to patient's phone if it's vodafone (010) or patient's phone
      const defaultWalletPhone = state.patientPhone || '01012345678';

      return `
        <div class="payment-layout">
          <div class="payment-main">
            <div class="payment-main-inner card payment-card">
              <!-- Processing overlay (hidden by default) -->
              <div class="payment-processing" id="payment-processing-overlay" style="display: none;">
                <div class="processing-orbit">
                  ${Icons.wallet}
                </div>
                <h3>جاري معالجة عملية الدفع</h3>
                <p>يرجى الانتظار ثوانٍ معدودة، جاري التواصل الآمن مع بوابة فودافون كاش…</p>
                <div class="processing-progress">
                  <div class="processing-step is-current" id="p-step-1">
                    <span class="processing-step__dot">${Icons.check}</span>
                    <span>التحقق من صحة رقم المحفظة</span>
                  </div>
                  <div class="processing-step" id="p-step-2">
                    <span class="processing-step__dot">${Icons.check}</span>
                    <span>خصم وتحويل قيمة الكشف (${price} ج.م)</span>
                  </div>
                  <div class="processing-step" id="p-step-3">
                    <span class="processing-step__dot">${Icons.check}</span>
                    <span>إصدار إيصال وتأكيد الحجز النهائي</span>
                  </div>
                </div>
              </div>

              <div class="payment-card__head">
                <div>
                  <h2>محاكاة بوابة الدفع الإلكتروني</h2>
                  <p>اختر محفظة فودافون كاش لتأكيد حجز موعدك الطبي فوراً.</p>
                </div>
                <div class="payment-amount-chip">
                  <span>المبلغ المطلوب:</span>
                  <strong>${price}</strong>
                  <small>${settings.currency || 'ج.م'}</small>
                </div>
              </div>

              <div class="payment-card__body">
                <div class="payment-section-label">
                  <strong>وسيلة الدفع المتاحة</strong>
                  <span>محفظة إلكترونية</span>
                </div>

                <div class="payment-method">
                  <div class="payment-method__logo">
                    ${Icons.wallet}
                  </div>
                  <div class="payment-method__main">
                    <strong>فودافون كاش (Vodafone Cash)</strong>
                    <span>${Icons.shield} دفع فوري ومباشر لحساب العيادة</span>
                  </div>
                  <div class="payment-method__radio"></div>
                </div>

                <form id="payment-gateway-form" class="wallet-section">
                  <div class="field">
                    <label for="wallet-phone-input">رقم محفظة فودافون كاش المحول منها *</label>
                    <div class="wallet-field-shell">
                      <span class="country-prefix">+20 (مصر)</span>
                      <input type="tel" id="wallet-phone-input" class="input" placeholder="010xxxxxxxx" required value="${defaultWalletPhone}">
                      <span class="wallet-icon">${Icons.phone}</span>
                    </div>
                    <span class="field-error" id="wallet-error" style="display: none; color: var(--red-600); font-size: 10px; margin-top: 3px;">يرجى إدخال رقم محفظة فودافون كاش صحيح مكون من 11 رقماً.</span>
                  </div>

                  <div class="payment-lock-note">
                    ${Icons.lock}
                    <span>المبلغ محدد تلقائياً بناءً على تسعيرة العيادة الرسمية (غير قابل للتعديل).</span>
                  </div>

                  <!-- Test scenario toggle -->
                  <div class="demo-payment-type">
                    <div class="demo-payment-type__copy">
                      <strong>سيناريو اختبار العملية (للتقييم والتدقيق):</strong>
                      <span>اختر النتيجة لمحاكاة الرد من بوابة الدفع</span>
                    </div>
                    <div class="segmented" style="display: flex; gap: 4px; background: #e5ebef; padding: 3px; border-radius: 8px;">
                      <label style="cursor: pointer; padding: 4px 10px; border-radius: 6px; font-size: 10px; font-weight: 700; ${state.paymentScenario === 'success' ? 'background: #fff; color: var(--navy-900);' : 'color: var(--muted);'}">
                        <input type="radio" name="paymentScenarioRadio" value="success" ${state.paymentScenario === 'success' ? 'checked' : ''} style="display: none;">
                        دفع ناجح (افتراضي)
                      </label>
                      <label style="cursor: pointer; padding: 4px 10px; border-radius: 6px; font-size: 10px; font-weight: 700; ${state.paymentScenario === 'fail' ? 'background: #fff; color: var(--red-700);' : 'color: var(--muted);'}">
                        <input type="radio" name="paymentScenarioRadio" value="fail" ${state.paymentScenario === 'fail' ? 'checked' : ''} style="display: none;">
                        محاكاة فشل العملية
                      </label>
                    </div>
                  </div>

                  <div class="simulated-note">
                    ${Icons.alert}
                    <div>
                      <strong>تنبيه الأمان والخصوصية:</strong> هذه محاكاة تجريبية مخصصة للعرض والتدقيق فقط — لن يتم خصم أو سحب أي أموال حقيقية من هاتفك، ولن يُطلب منك إدخال أي رقم سري (PIN) أو رمز تحقق (OTP).
                    </div>
                  </div>

                  <div class="payment-actions">
                    <button type="button" class="btn btn--outline" id="back-to-step2-btn">
                      ${Icons.arrowRight} تعديل البيانات
                    </button>
                    <button type="submit" class="btn btn--accent" id="confirm-payment-btn">
                      تأكيد ودفع ${price} ج.م ${Icons.check}
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- Order Summary Sidebar -->
          <aside class="order-summary">
            <div class="order-summary__head">
              <h2>${Icons.calendar} تفاصيل الحجز والمريض</h2>
            </div>
            <div class="order-summary__body">
              <div class="selected-appointment">
                <div class="selected-date-box">
                  <strong>${DateHelper.fromISODate(dateIso).getDate()}</strong>
                  <span>${MONTH_NAMES[DateHelper.fromISODate(dateIso).getMonth()]}</span>
                </div>
                <div class="selected-appointment__main">
                  <strong>${DateHelper.formatDateArabic(dateIso, false)}</strong>
                  <span>${Icons.clock} ${DateHelper.formatTimeArabic(slot.startTime)} - ${DateHelper.formatTimeArabic(slot.endTime)}</span>
                </div>
              </div>

              <div class="summary-lines">
                <div class="summary-line">
                  <span>${Icons.user} اسم المريض</span>
                  <strong>${state.patientName}</strong>
                </div>
                <div class="summary-line">
                  <span>${Icons.phone} رقم الهاتف</span>
                  <strong style="direction: ltr;">${state.patientPhone}</strong>
                </div>
                <div class="summary-line">
                  <span>${Icons.stethoscope} الطبيب المعالج</span>
                  <strong>${settings.doctorName || 'د. أحمد محمد'}</strong>
                </div>
              </div>

              <div class="summary-total">
                <span>المبلغ الإجمالي المطلوب</span>
                <strong>${price} <small>${settings.currency || 'ج.م'}</small></strong>
              </div>
            </div>
          </aside>
        </div>
      `;
    },

    /* Step 4: Booking Confirmation & Printable Receipt */
    PatientStep4() {
      const state = App.patientBookingState;
      const settings = ClinicEngine.getSettings();
      const booking = state.bookingResult;

      if (!booking) {
        return `
          <div class="card unavailable-card">
            <div class="empty-state__art">${Icons.alert}</div>
            <h1>لا يوجد حجز مؤكد حالياً</h1>
            <p>يرجى بدء حجز جديد باختيار الموعد المناسب من جدول العيادة.</p>
            <button class="btn btn--accent" id="restart-booking-btn">حجز موعد جديد</button>
          </div>
        `;
      }

      return `
        <div class="success-page">
          <div class="success-card">
            <div class="success-card__top">
              <div class="success-icon">
                ${Icons.check}
              </div>
              <h1>تم تأكيد حجزك بنجاح!</h1>
              <p>تم سداد قيمة الكشف عبر فودافون كاش وتسجيل الموعد رسمياً في جدول عيادة ${settings.clinicName || 'عيادة الشفاء'}.</p>
              <div class="success-booking-chip">
                <span>كود الحجز المرجعي:</span>
                <strong>${booking.id}</strong>
              </div>
            </div>

            <div class="success-card__body">
              <div class="receipt" id="printable-receipt">
                <div class="receipt-head">
                  <div class="receipt-brand">
                    <div class="brand-mark">${Icons.stethoscope}</div>
                    <div>
                      <strong>${settings.clinicName || 'عيادة الشفاء التخصصية'}</strong>
                      <span>${settings.doctorName || 'د. أحمد محمد'} — ${settings.specialty || 'طب الباطنة'}</span>
                    </div>
                  </div>
                  <div class="receipt-status">
                    <span class="badge badge--green">مدفوع بالكامل</span>
                    <span>${Icons.calendar} ${DateHelper.formatDateArabic(booking.date, false)}</span>
                  </div>
                </div>

                <div class="receipt-grid">
                  <div class="receipt-row">
                    <span>${Icons.user} اسم المريض:</span>
                    <strong>${booking.patientName}</strong>
                  </div>
                  <div class="receipt-row">
                    <span>${Icons.phone} هاتف المريض:</span>
                    <strong style="direction: ltr; text-align: right;">${booking.patientPhone}</strong>
                  </div>
                  <div class="receipt-row">
                    <span>${Icons.calendar} تاريخ الكشف:</span>
                    <strong>${DateHelper.formatDateArabic(booking.date)}</strong>
                  </div>
                  <div class="receipt-row">
                    <span>${Icons.clock} توقيت الجلسة:</span>
                    <strong>${DateHelper.formatTimeArabic(booking.startTime)} إلى ${DateHelper.formatTimeArabic(booking.endTime)}</strong>
                  </div>
                  <div class="receipt-row">
                    <span>${Icons.wallet} وسيلة الدفع:</span>
                    <strong>فودافون كاش (${booking.walletPhone || booking.patientPhone})</strong>
                  </div>
                  <div class="receipt-row">
                    <span>${Icons.cash} المبلغ المسدد:</span>
                    <strong class="is-price">${booking.amount} ${booking.currency}</strong>
                  </div>
                  <div class="receipt-row">
                    <span>${Icons.shield} رقم المعاملة:</span>
                    <strong class="is-code">${booking.paymentId}</strong>
                  </div>
                  <div class="receipt-row">
                    <span>${Icons.checkCircle} حالة الحجز:</span>
                    <strong style="color: var(--green-700);">مؤكد في العيادة</strong>
                  </div>
                </div>

                <div class="receipt-foot">
                  <span>${Icons.info} يرجى الحضور قبل الموعد بـ 10 دقائق وإبراز كود الحجز.</span>
                  <span>رقم الهاتف: ${booking.patientPhone}</span>
                </div>
              </div>

              <div class="success-actions">
                <button class="btn btn--accent" id="print-receipt-btn">
                  ${Icons.printer} طباعة إيصال الحجز
                </button>
                <button class="btn btn--outline" id="new-booking-btn">
                  ${Icons.plus} حجز موعد جديد
                </button>
              </div>

              <div class="success-help">
                ${Icons.sparkles}
                <div>
                  <strong>تم تحديث لوحة تحكم الطبيب تلقائياً!</strong> يمكنك الآن التوجه إلى لوحة تحكم الطبيب والتحقق من ظهور هذا الحجز فوراً في قائمة حجوزات اليوم والإحصائيات.
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    },

    bindPatientPortalEvents() {
      // Header button to open doctor portal
      document.getElementById('patient-to-doctor-btn')?.addEventListener('click', () => {
        if (Auth.isLoggedIn()) App.navigate('doctor', 'overview');
        else App.navigate('doctor-login');
      });

      // Step 1: Select date ribbon
      document.querySelectorAll('.booking-date:not([disabled])').forEach(btn => {
        btn.addEventListener('click', () => {
          const iso = btn.getAttribute('data-iso');
          App.patientBookingState.selectedDate = iso;
          App.refreshCurrentView();
        });
      });

      // Step 1: Select slot button
      document.querySelectorAll('.select-slot-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const slotId = btn.getAttribute('data-id');
          const start = btn.getAttribute('data-start');
          const end = btn.getAttribute('data-end');

          App.patientBookingState.selectedSlot = {
            id: slotId,
            startTime: start,
            endTime: end
          };
          App.refreshCurrentView();
        });
      });

      // Step 2: Back to Step 1
      document.getElementById('back-to-step1-btn')?.addEventListener('click', () => {
        App.patientBookingState.selectedSlot = null;
        App.refreshCurrentView();
      });

      // Step 2: Form submit
      const infoForm = document.getElementById('patient-info-form');
      if (infoForm) {
        infoForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const nameInput = document.getElementById('patient-fullname');
          const phoneInput = document.getElementById('patient-phone');
          const nameErr = document.getElementById('name-error');
          const phoneErr = document.getElementById('phone-error');

          const name = (nameInput?.value || '').trim();
          let phone = (phoneInput?.value || '').trim().replace(/[\s-]/g, '');

          let valid = true;

          // Full Name Validation (at least 3 characters)
          if (!name || name.length < 3) {
            if (nameErr) nameErr.style.display = 'block';
            valid = false;
          } else {
            if (nameErr) nameErr.style.display = 'none';
          }

          // Egyptian Phone Validation (010, 011, 012, 015 - 11 digits)
          const egPhoneRegex = /^01[0125][0-9]{8}$/;
          if (!egPhoneRegex.test(phone)) {
            if (phoneErr) phoneErr.style.display = 'block';
            valid = false;
          } else {
            if (phoneErr) phoneErr.style.display = 'none';
          }

          if (valid) {
            App.patientBookingState.patientName = name;
            App.patientBookingState.patientPhone = phone;
            App.refreshCurrentView();
          }
        });
      }

      // Step 3: Back to Step 2
      document.getElementById('back-to-step2-btn')?.addEventListener('click', () => {
        App.patientBookingState.patientName = '';
        App.patientBookingState.patientPhone = '';
        App.refreshCurrentView();
      });

      // Step 3: Payment scenario toggle
      document.querySelectorAll('input[name="paymentScenarioRadio"]').forEach(radio => {
        radio.addEventListener('change', () => {
          App.patientBookingState.paymentScenario = radio.value;
          App.refreshCurrentView();
        });
      });

      // Step 3: Payment form submit
      const paymentForm = document.getElementById('payment-gateway-form');
      if (paymentForm) {
        paymentForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const walletInput = document.getElementById('wallet-phone-input');
          const walletErr = document.getElementById('wallet-error');
          const overlay = document.getElementById('payment-processing-overlay');
          const submitBtn = document.getElementById('confirm-payment-btn');

          const walletPhone = (walletInput?.value || '').trim().replace(/[\s-]/g, '');
          const egPhoneRegex = /^01[0125][0-9]{8}$/;

          if (!egPhoneRegex.test(walletPhone)) {
            if (walletErr) walletErr.style.display = 'block';
            return;
          }
          if (walletErr) walletErr.style.display = 'none';

          // Disable submit button & show processing overlay
          if (submitBtn) submitBtn.disabled = true;
          if (overlay) overlay.style.display = 'flex';

          const pStep1 = document.getElementById('p-step-1');
          const pStep2 = document.getElementById('p-step-2');
          const pStep3 = document.getElementById('p-step-3');

          // Simulate payment steps
          setTimeout(() => {
            if (pStep1) pStep1.className = 'processing-step is-done';
            if (pStep2) pStep2.className = 'processing-step is-current';
          }, 600);

          setTimeout(() => {
            if (pStep2) pStep2.className = 'processing-step is-done';
            if (pStep3) pStep3.className = 'processing-step is-current';

            // Check if scenario is fail
            if (App.patientBookingState.paymentScenario === 'fail') {
              setTimeout(() => {
                if (overlay) overlay.style.display = 'none';
                if (submitBtn) submitBtn.disabled = false;
                showToast('فشل الدفع التجريبي', 'فشلت عملية التحويل من المحفظة (سيناريو الاختبار). يرجى التأكد من الرصيد أو تجربة سيناريو الدفع الناجح.', 'error', 6000);
              }, 600);
              return;
            }

            // Success scenario: perform actual booking in ClinicEngine
            const state = App.patientBookingState;
            const settings = ClinicEngine.getSettings();

            const res = ClinicEngine.createBooking({
              patientName: state.patientName,
              patientPhone: state.patientPhone,
              dateIso: state.selectedDate,
              slot: state.selectedSlot,
              amount: settings.price || 100,
              walletPhone
            });

            setTimeout(() => {
              if (res.success) {
                state.bookingResult = res.booking;
                showToast('تم تأكيد الحجز', 'تم سداد الكشف بنجاح وتسجيل حجزك.', 'success');
                App.refreshCurrentView();
              } else {
                if (overlay) overlay.style.display = 'none';
                if (submitBtn) submitBtn.disabled = false;
                showToast('تعذر إتمام الحجز', res.error, 'error', 6000);
              }
            }, 500);

          }, 1400);
        });
      }

      // Step 4: Print receipt
      document.getElementById('print-receipt-btn')?.addEventListener('click', () => {
        window.print();
      });

      // Step 4: New booking
      const restartBooking = () => {
        App.patientBookingState = {
          selectedDate: DateHelper.todayISO(),
          selectedSlot: null,
          patientName: '',
          patientPhone: '',
          paymentScenario: 'success',
          bookingResult: null
        };
        App.refreshCurrentView();
      };
      document.getElementById('new-booking-btn')?.addEventListener('click', restartBooking);
      document.getElementById('restart-booking-btn')?.addEventListener('click', restartBooking);
    }
  };

  /* ==========================================================================
     11. MODAL DIALOGS
     ========================================================================== */

  const Modals = {
    // Add slot modal
    openAddSlotModal(dateIso) {
      const date = DateHelper.fromISODate(dateIso);
      const dayKey = DateHelper.getDayKey(date);
      const dayName = DateHelper.getDayName(dayKey);
      const settings = ClinicEngine.getSettings();
      const defaultDuration = settings.defaultDuration || 30;

      // Smart default times
      const existingSlots = ClinicEngine.getScheduleForDate(dateIso);
      let defaultStart = '17:00'; // Default 5:00 PM for testing!
      if (existingSlots.some(s => s.startTime === defaultStart)) {
        defaultStart = '18:00';
      }
      const defaultEnd = DateHelper.minutesToTime(DateHelper.timeToMinutes(defaultStart) + defaultDuration);

      const html = `
        <div class="modal__head">
          <div>
            <h2>${Icons.plus} إضافة جلسة عمل جديدة</h2>
            <p>ليوم ${dayName}، ${DateHelper.formatDateArabic(dateIso)}</p>
          </div>
          <button class="modal__close" data-modal-close aria-label="إغلاق">${Icons.x}</button>
        </div>

        <form id="modal-add-slot-form">
          <div class="modal__body">
            <div class="modal-form-grid">
              <div class="field">
                <label for="slot-start-time">وقت بداية الجلسة *</label>
                <input type="time" id="slot-start-time" class="input" required value="${defaultStart}">
              </div>
              <div class="field">
                <label for="slot-end-time">وقت نهاية الجلسة *</label>
                <input type="time" id="slot-end-time" class="input" required value="${defaultEnd}">
              </div>
            </div>

            <div class="duration-hint" style="margin-top: 10px;">
              ${Icons.clock} <span id="add-duration-preview">مدة الجلسة: ${defaultDuration} دقيقة</span>
            </div>

            <div class="modal-section-label">نطاق تطبيق الموعد الجديد</div>
            <div class="scope-options">
              <label class="scope-option">
                <input type="radio" name="slotScope" value="weekly" checked>
                <span class="scope-option__radio"></span>
                <div class="scope-option__copy">
                  <strong>${Icons.calendar} تطبيق على الجدول الأسبوعي المتكرر (موصى به)</strong>
                  <span>ستتكرر هذه الجلسة في جميع أيام ${dayName} القادمة في جدول العيادة.</span>
                </div>
              </label>

              <label class="scope-option">
                <input type="radio" name="slotScope" value="single">
                <span class="scope-option__radio"></span>
                <div class="scope-option__copy">
                  <strong>${Icons.clock} تطبيق على هذا التاريخ فقط (${DateHelper.formatDateArabic(dateIso, false)})</strong>
                  <span>ستضاف الجلسة كاستثناء لهذا اليوم فقط دون التأثير على باقي الأسابيع.</span>
                </div>
              </label>
            </div>
          </div>

          <div class="modal__foot">
            <button type="button" class="btn btn--outline" data-modal-close>إلغاء</button>
            <button type="submit" class="btn btn--accent">${Icons.check} حفظ الجلسة</button>
          </div>
        </form>
      `;

      Modal.open(html);

      // Duration auto update helper
      const startInput = document.getElementById('slot-start-time');
      const endInput = document.getElementById('slot-end-time');
      const preview = document.getElementById('add-duration-preview');

      const updateDur = () => {
        if (!startInput || !endInput || !preview) return;
        const diff = DateHelper.timeToMinutes(endInput.value) - DateHelper.timeToMinutes(startInput.value);
        if (diff > 0) preview.textContent = `مدة الجلسة: ${diff} دقيقة (${DateHelper.formatTimeArabic(startInput.value)} إلى ${DateHelper.formatTimeArabic(endInput.value)})`;
        else preview.textContent = 'تنبيه: وقت النهاية يجب أن يكون بعد البداية';
      };

      startInput?.addEventListener('input', updateDur);
      endInput?.addEventListener('input', updateDur);

      // Form submit
      document.getElementById('modal-add-slot-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const startTime = startInput.value;
        const endTime = endInput.value;
        const scope = document.querySelector('input[name="slotScope"]:checked')?.value || 'weekly';

        const res = ClinicEngine.addSlot({ dayKey, dateIso, startTime, endTime, scope });
        if (res.success) {
          Modal.close();
          showToast('تمت الإضافة', `تمت إضافة جلسة (${DateHelper.formatTimeArabic(startTime)} - ${DateHelper.formatTimeArabic(endTime)}) بنجاح.`, 'success');
          App.refreshCurrentView();
        } else {
          showToast('تعذر الحفظ', res.error, 'error');
        }
      });
    },

    // Edit slot modal
    openEditSlotModal(slot, dateIso) {
      const date = DateHelper.fromISODate(dateIso);
      const dayKey = DateHelper.getDayKey(date);
      const dayName = DateHelper.getDayName(dayKey);

      const html = `
        <div class="modal__head">
          <div>
            <h2>${Icons.edit} تعديل وقت الجلسة</h2>
            <p>الجلسة الحالية: ${DateHelper.formatTimeArabic(slot.startTime)} - ${DateHelper.formatTimeArabic(slot.endTime)}</p>
          </div>
          <button class="modal__close" data-modal-close aria-label="إغلاق">${Icons.x}</button>
        </div>

        <form id="modal-edit-slot-form">
          <div class="modal__body">
            <div class="modal-form-grid">
              <div class="field">
                <label for="edit-start-time">وقت البداية الجديد *</label>
                <input type="time" id="edit-start-time" class="input" required value="${slot.startTime}">
              </div>
              <div class="field">
                <label for="edit-end-time">وقت النهاية الجديد *</label>
                <input type="time" id="edit-end-time" class="input" required value="${slot.endTime}">
              </div>
            </div>

            <div class="modal-section-label">نطاق تطبيق التعديل</div>
            <div class="scope-options">
              <label class="scope-option">
                <input type="radio" name="editScope" value="single" checked>
                <span class="scope-option__radio"></span>
                <div class="scope-option__copy">
                  <strong>${Icons.clock} تطبيق التعديل على هذا التاريخ فقط (${DateHelper.formatDateArabic(dateIso, false)})</strong>
                  <span>تعديل استثنائي لهذا اليوم دون تغيير المواعيد في الأسابيع الأخرى.</span>
                </div>
              </label>

              <label class="scope-option">
                <input type="radio" name="editScope" value="weekly">
                <span class="scope-option__radio"></span>
                <div class="scope-option__copy">
                  <strong>${Icons.calendar} تطبيق على الجدول الأسبوعي المتكرر (جميع أيام ${dayName})</strong>
                  <span>تعديل الموعد الدائم في الجدول الأسبوعي مع الحفاظ التام على الحجوزات السابقة.</span>
                </div>
              </label>
            </div>
          </div>

          <div class="modal__foot">
            <button type="button" class="btn btn--outline" data-modal-close>إلغاء</button>
            <button type="submit" class="btn btn--accent">${Icons.check} حفظ التعديلات</button>
          </div>
        </form>
      `;

      Modal.open(html);

      document.getElementById('modal-edit-slot-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const startTime = document.getElementById('edit-start-time').value;
        const endTime = document.getElementById('edit-end-time').value;
        const scope = document.querySelector('input[name="editScope"]:checked')?.value || 'single';

        const res = ClinicEngine.editSlot({ slotId: slot.id, dayKey, dateIso, startTime, endTime, scope });
        if (res.success) {
          Modal.close();
          showToast('تم التعديل', 'تم تحديث توقيت الجلسة بنجاح.', 'success');
          App.refreshCurrentView();
        } else {
          showToast('تعذر التعديل', res.error, 'error');
        }
      });
    },

    // Delete slot modal
    openDeleteSlotModal(slot, dateIso) {
      const date = DateHelper.fromISODate(dateIso);
      const dayKey = DateHelper.getDayKey(date);
      const dayName = DateHelper.getDayName(dayKey);

      const html = `
        <div class="modal__head">
          <div>
            <h2>${Icons.trash} تأكيد حذف جلسة العمل</h2>
            <p>الجلسة: ${DateHelper.formatTimeArabic(slot.startTime)} - ${DateHelper.formatTimeArabic(slot.endTime)}</p>
          </div>
          <button class="modal__close" data-modal-close aria-label="إغلاق">${Icons.x}</button>
        </div>

        <form id="modal-delete-slot-form">
          <div class="modal__body">
            <div class="modal-section-label">اختر نطاق الحذف:</div>
            <div class="scope-options">
              <label class="scope-option">
                <input type="radio" name="deleteScope" value="single" checked>
                <span class="scope-option__radio"></span>
                <div class="scope-option__copy">
                  <strong>${Icons.clock} إلغاء الجلسة في هذا التاريخ فقط (${DateHelper.formatDateArabic(dateIso, false)})</strong>
                  <span>حذف الجلسة اليوم كعطلة أو استثناء مع بقائها في الأسابيع التالية.</span>
                </div>
              </label>

              <label class="scope-option">
                <input type="radio" name="deleteScope" value="weekly">
                <span class="scope-option__radio"></span>
                <div class="scope-option__copy">
                  <strong>${Icons.calendar} حذف نهائي من الجدول الأسبوعي المتكرر (جميع أيام ${dayName})</strong>
                  <span>حذف الجلسة تماماً من الجدول الأسبوعي الدائم. الحجوزات السابقة لن تُمس.</span>
                </div>
              </label>
            </div>
          </div>

          <div class="modal__foot">
            <button type="button" class="btn btn--outline" data-modal-close>تراجع</button>
            <button type="submit" class="btn btn--danger">${Icons.trash} تأكيد الحذف</button>
          </div>
        </form>
      `;

      Modal.open(html);

      document.getElementById('modal-delete-slot-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const scope = document.querySelector('input[name="deleteScope"]:checked')?.value || 'single';

        ClinicEngine.deleteSlot({ slotId: slot.id, dayKey, dateIso, scope });
        Modal.close();
        showToast('تم الحذف', 'تم حذف الجلسة المحددة بنجاح.', 'success');
        App.refreshCurrentView();
      });
    },

    // Booking Details Modal
    openBookingDetailsModal(bookingId) {
      const bookings = ClinicEngine.getBookings();
      const booking = bookings.find(b => b.id === bookingId);
      if (!booking) {
        showToast('خطأ', 'لم يتم العثور على الحجز المطلوب.', 'error');
        return;
      }

      const settings = ClinicEngine.getSettings();

      const html = `
        <div class="modal__head">
          <div class="booking-detail-head">
            <div class="patient-avatar">${booking.patientName.charAt(0) || 'م'}</div>
            <div>
              <h2>${booking.patientName}</h2>
              <p>كود الحجز: <code>${booking.id}</code> <span class="dot"></span> هاتف: ${booking.patientPhone}</p>
            </div>
          </div>
          <button class="modal__close" data-modal-close aria-label="إغلاق">${Icons.x}</button>
        </div>

        <div class="modal__body">
          <div class="booking-detail-grid">
            <div class="detail-block">
              <span>${Icons.calendar} تاريخ الكشف الطبي</span>
              <strong>${DateHelper.formatDateArabic(booking.date)}</strong>
            </div>

            <div class="detail-block">
              <span>${Icons.clock} توقيت الجلسة</span>
              <strong>${DateHelper.formatTimeArabic(booking.startTime)} - ${DateHelper.formatTimeArabic(booking.endTime)}</strong>
            </div>

            <div class="detail-block">
              <span>${Icons.cash} قيمة الكشف المسددة</span>
              <strong class="price">${booking.amount} ${booking.currency}</strong>
            </div>

            <div class="detail-block">
              <span>${Icons.wallet} طريقة الدفع الإلكتروني</span>
              <strong>${booking.paymentMethod} (${booking.walletPhone || booking.patientPhone})</strong>
            </div>

            <div class="detail-block">
              <span>${Icons.shield} رقم عملية الدفع</span>
              <strong class="ltr">${booking.paymentId}</strong>
            </div>

            <div class="detail-block">
              <span>${Icons.checkCircle} حالة الحجز الحالية</span>
              <div>
                <span class="badge ${booking.bookingStatus === 'confirmed' ? 'badge--green' : booking.bookingStatus === 'completed' ? 'badge--blue' : 'badge--red'}">
                  ${booking.bookingStatus === 'confirmed' ? 'مؤكد في العيادة' : booking.bookingStatus === 'completed' ? 'تم الحضور واكتمال الكشف' : 'حجز ملغي'}
                </span>
              </div>
            </div>

            <div class="detail-note">
              ${Icons.info}
              <span>${booking.notes || 'تم تأكيد الحجز إلكترونياً وسداد الرسوم بنجاح عبر محفظة فودافون كاش.'}</span>
            </div>
          </div>
        </div>

        <div class="modal__foot">
          <button type="button" class="btn btn--outline" id="print-modal-receipt-btn">${Icons.printer} طباعة إيصال الحجز</button>
          
          ${booking.bookingStatus === 'confirmed' ? `
            <button type="button" class="btn btn--outline btn--danger-soft" id="cancel-booking-btn">إلغاء الحجز</button>
            <button type="button" class="btn btn--accent" id="complete-booking-btn">${Icons.check} تم حضور المريض</button>
          ` : `
            <button type="button" class="btn btn--outline" data-modal-close>إغلاق</button>
          `}
        </div>
      `;

      Modal.open(html);

      document.getElementById('print-modal-receipt-btn')?.addEventListener('click', () => {
        window.print();
      });

      document.getElementById('complete-booking-btn')?.addEventListener('click', () => {
        ClinicEngine.updateBookingStatus(booking.id, 'completed');
        Modal.close();
        showToast('تم التحديث', 'تم تسجيل اكتمال الكشف بنجاح.', 'success');
        App.refreshCurrentView();
      });

      document.getElementById('cancel-booking-btn')?.addEventListener('click', () => {
        if (confirm('هل أنت متأكد من رغبتك في إلغاء هذا الحجز؟ ستصبح الجلسة متاحة للحجز مرة أخرى.')) {
          ClinicEngine.updateBookingStatus(booking.id, 'cancelled');
          Modal.close();
          showToast('تم الإلغاء', 'تم إلغاء الحجز وأصبحت الجلسة متاحة مجدداً.', 'info');
          App.refreshCurrentView();
        }
      });
    },

    // Reset Data Modal
    openResetDataConfirm() {
      const html = `
        <div class="modal__head">
          <div>
            <h2>${Icons.alert} استعادة البيانات التجريبية</h2>
            <p>إعادة ضبط نظام العيادة بالكامل</p>
          </div>
          <button class="modal__close" data-modal-close aria-label="إغلاق">${Icons.x}</button>
        </div>
        <div class="modal__body">
          <div class="confirm-copy">
            <div class="modal__icon modal__icon--amber">${Icons.refresh}</div>
            <h2>هل تود إعادة ضبط البيانات؟</h2>
            <p>سيتم استعادة جدول المواعيد الافتراضي لعيادة د. أحمد محمد، وإعادة الحساب التجريبي وكلمة المرور الأصلية (Doctor@123).</p>
          </div>
        </div>
        <div class="modal__foot">
          <button type="button" class="btn btn--outline" data-modal-close>إلغاء</button>
          <button type="button" class="btn btn--accent" id="confirm-reset-btn">${Icons.refresh} تأكيد إعادة الضبط</button>
        </div>
      `;

      Modal.open(html);

      document.getElementById('confirm-reset-btn')?.addEventListener('click', () => {
        initDemoData(true);
        Modal.close();
        showToast('تمت إعادة الضبط', 'تم استعادة البيانات التجريبية الأولية بنجاح.', 'success');
        App.refreshCurrentView();
      });
    },

    // Logout Modal
    openLogoutConfirm() {
      const html = `
        <div class="modal__head">
          <div>
            <h2>تسجيل الخروج</h2>
          </div>
          <button class="modal__close" data-modal-close aria-label="إغلاق">${Icons.x}</button>
        </div>
        <div class="modal__body">
          <div class="confirm-copy">
            <div class="modal__icon modal__icon--danger">${Icons.logout}</div>
            <h2>تأكيد تسجيل الخروج</h2>
            <p>هل تود تسجيل الخروج من لوحة تحكم الطبيب؟ سيتطلب الدخول مجدداً كتابة كلمة المرور.</p>
          </div>
        </div>
        <div class="modal__foot">
          <button type="button" class="btn btn--outline" data-modal-close>تراجع</button>
          <button type="button" class="btn btn--danger" id="confirm-logout-btn">نعم، تسجيل الخروج</button>
        </div>
      `;

      Modal.open(html);

      document.getElementById('confirm-logout-btn')?.addEventListener('click', () => {
        Auth.logout();
        Modal.close();
        showToast('تم تسجيل الخروج', 'تم إنهاء الجلسة بأمان.', 'info');
        App.navigate('doctor-login');
      });
    }
  };

  /* ==========================================================================
     12. EXPORT & BOOTSTRAP
     ========================================================================== */

  window.nabdApp = App;

  // Run when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => App.init());
  } else {
    App.init();
  }

})();
